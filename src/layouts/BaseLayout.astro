---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** "dark" = nav scura da subito (pagine senza hero immersivo) */
  navMode?: 'light' | 'dark';
}

const { title, description, image, type, noindex, jsonLd, navMode = 'dark' } = Astro.props;
// font ospitati sul sito: nessun collegamento a Google Fonts (privacy)
import '@fontsource/almarai/300.css';
import '@fontsource/almarai/400.css';
import '@fontsource/almarai/700.css';
import '@fontsource/almarai/800.css';
import '@fontsource/antic-didone/400.css';
import CookieConsent from '../components/CookieConsent.astro';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <SEO title={title} description={description} image={image} type={type} noindex={noindex} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body data-nav={navMode}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-3 focus:left-3 focus:bg-ink focus:text-bg focus:px-4 focus:py-2">Salta al contenuto</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      import '../scripts/justified';
      import '../scripts/lightbox';
    </script>
    <script>
      // segna JS attivo: lo stato "nascosto" dei .reveal esiste solo con questa classe
      document.documentElement.classList.add('js');

      const revealAll = () => document.querySelectorAll('.reveal, .grow-line').forEach((el) => el.classList.add('is-in'));

      if (!('IntersectionObserver' in window)) {
        // browser senza IO o motion ridotto: mostra tutto subito
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' },
        );
        const observe = () => document.querySelectorAll('.reveal, .grow-line').forEach((el) => {
          if (el.classList.contains('is-in')) return;
          const r = el.getBoundingClientRect();
          // già in viewport al load: mostra senza aspettare uno scroll
          if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('is-in');
          else io.observe(el);
        });
        observe();
        document.addEventListener('astro:after-swap', observe);
        // rete di sicurezza: niente contenuto invisibile se l'IO non scatta
        setTimeout(revealAll, 2600);
      }
    </script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .focus\:not-sr-only:focus {
    position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal;
  }
</style>
