---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProcessScroll from "../components/ProcessScroll.astro";
import Reviews from "../components/Reviews.astro";
import Clients from "../components/Clients.astro";
import Button from "../components/Button.astro";
import { getInEvidenza, getProgetto, coverOf, getHeroImages } from "../data/projects";
import { site, manifestoQuote, ambiti, homeTesti } from "../data/site";

// hero: le foto con "Foto grande in home" attivo nel pannello, alternate a caso nel browser
const heroSlides = await Promise.all(
  (await getHeroImages()).map(async (h) => {
    // versioni fino a 3840 px: su telefono in verticale la foto riempie l'altezza dello schermo,
    // quindi serve molto più larga dello schermo (sizes calcolato sulla forma della foto)
    const img = await getImage({ src: h.src, widths: [800, 1280, 1920, 2560, 3200, 3840], format: "webp" });
    const ratio = h.src.width / h.src.height;
    const sizes = `(orientation: portrait) ${Math.ceil(100 * ratio)}vh, 100vw`;
    const p = await getProgetto(h.slug);
    return { src: img.src, srcset: img.srcSet.attribute, sizes, alt: p ? `${p.data.titolo}, progetto di Riccardo Bandera Architetto` : "Progetto di Riccardo Bandera Architetto" };
  }),
);
const noscriptImg = heroSlides[0];

// titolo della hero: abitazioni, hotel, uffici e negozi portano ai progetti di quell'ambito
// (il testo resta modificabile dal pannello: si collegano solo le parole che ci sono)
const AMBITI_TITOLO: [RegExp, string][] = [
  [/(?<!\p{L})(abitazioni|case)(?!\p{L})/iu, 'residenziale'],
  [/(?<!\p{L})(hotel|alberghi)(?!\p{L})/iu, 'alberghiero'],
  [/(?<!\p{L})(uffici)(?!\p{L})/iu, 'direzionale'],
  [/(?<!\p{L})(negozi|locali)(?!\p{L})/iu, 'commerciale'],
];
// citazione: le parole tra **due asterischi** (scritte così nel pannello) diventano grassetto
const citazioneHtml = manifestoQuote
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold">$1</strong>');
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
let taglineLinkata = esc(site.tagline);
for (const [re, ambito] of AMBITI_TITOLO) {
  taglineLinkata = taglineLinkata.replace(re, (w) => `<a href="/progetti/?ambito=${ambito}" class="hero-word">${w}</a>`);
}

const featured = await getInEvidenza();

// copertine per gli ambiti: un progetto rappresentativo per ciascuno
const AMBITO_COVER: Record<string, string> = {
  residenziale: "c022-villa-con-affaccio-sul-lago-di-garda-realizzata-in-legno-a-verona-vr",
  commerciale: "pmt-panificio-moderno-in-piazza-lodron-bar-e-ristorazione-in-centro-a-trento-tn",
  alberghiero: "kkh-kono-kono-hotel-and-villas-a-zanzibar-tanzania",
  direzionale: "mhq-nuovo-headquarter-manica-s-p-a-a-rovereto-tn",
};
const ambitiCards = (await Promise.all(
  ambiti.map(async (a) => {
    const p = await getProgetto(AMBITO_COVER[a.key]);
    const c = p ? coverOf(p) : null;
    return { ...a, cover: c?.src, alt: c?.alt ?? a.label };
  }),
)).filter((a) => a.cover);
---

<BaseLayout navMode="light" title={undefined}>
  <!-- ============ HERO ============ -->
  <section class="hero relative min-h-[100svh] flex items-end overflow-hidden bg-ink text-cream">
    <div class="hero-media absolute inset-0" data-hero-media>
      <div class="absolute inset-0" data-hero-slides>
        {heroSlides.map((s) => (
          <img class="hero-slide absolute inset-0 w-full h-full object-cover" data-src={s.src} data-srcset={s.srcset} sizes={s.sizes} alt={s.alt} decoding="async" />
        ))}
        <script is:inline>
          (function () {
            var s = document.querySelectorAll(".hero-slide");
            if (!s.length) return;
            var r = Math.floor(Math.random() * s.length), el = s[r];
            el.setAttribute("fetchpriority", "high");
            el.srcset = el.getAttribute("data-srcset"); el.src = el.getAttribute("data-src");
            el.classList.add("is-active"); window.__heroStart = r;
          })();
        </script>
        <noscript><img class="absolute inset-0 w-full h-full object-cover" src={noscriptImg.src} srcset={noscriptImg.srcset} sizes={noscriptImg.sizes} alt={noscriptImg.alt} /></noscript>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-ink/40"></div>
    </div>

    <!-- frecce: foto precedente / successiva -->
    {heroSlides.length > 1 && (
      <>
        <button type="button" class="hero-arrow left-3 md:left-6" data-hero-prev aria-label="Foto precedente">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="hero-arrow right-3 md:right-6" data-hero-next aria-label="Foto successiva">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </>
    )}

    <div class="u-container relative pb-24 md:pb-24 pt-32 w-full" data-hero-content>
      <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(1.6rem,7vw,5.4rem)] md:text-[clamp(2rem,6.4vw,5.4rem)] max-w-[20ch] md:max-w-[16ch] text-balance" set:html={taglineLinkata} />
      <div class="mt-7 md:mt-9 flex flex-col items-start sm:flex-row sm:items-center gap-5 sm:gap-10">
        <Button href="/progetti/" variant="onDark" arrow>Scopri i progetti</Button>
        <p class="max-w-md text-cream/75 text-[0.92rem] md:text-[0.98rem] leading-relaxed">{homeTesti.sottotitolo}</p>
      </div>
    </div>
  </section>

  <!-- ============ MANIFESTO QUOTE ============ -->
  <!-- z-10: la sezione Metodo sotto risale di qualche riga (vedi -mt in ProcessScroll) e non deve coprire il pulsante;
       niente riga divisoria (attraversava il titolo del Metodo), lo stesso spazio resta come margine -->
  <section class="u-container relative z-10 pt-20 md:pt-28 pb-14 md:pb-16">
    <div class="max-w-4xl mx-auto">
      <div class="text-center reveal">
        <blockquote class="font-display text-[clamp(1.5rem,3.4vw,2.6rem)] leading-[1.28] text-ink">
          <Fragment set:html={citazioneHtml} />
        </blockquote>
        <div class="mt-10 flex justify-center">
          <Button href="/manifesto/" variant="ghost" arrow>Leggi il manifesto</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LE 6 FASI (scroll orizzontale) ============ -->
  <ProcessScroll />

  <!-- ============ AMBITI (dark) ============ -->
  <section class="bg-ink text-cream py-[var(--spacing-section)]">
    <div class="u-container">
      <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <h2 class="text-[clamp(1.9rem,5vw,3.4rem)] font-extrabold tracking-tight uppercase">Ambiti d’intervento</h2>
        <p class="max-w-sm text-cream/60 leading-relaxed">{homeTesti.ambitiIntro}</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {ambitiCards.map((a, i) => (
          <a href={`/progetti/?ambito=${a.key}`} class="amb-card group relative overflow-hidden aspect-[3/4] bg-white/5 reveal" data-reveal-delay={(i % 4) + 1}>
            {a.cover && (
              <Image src={a.cover} alt={a.alt ?? a.label} widths={[300, 500, 700]} sizes="(max-width:1024px) 46vw, 24vw"
                class="amb-img w-full h-full object-cover" />
            )}
            <div class="amb-veil absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent"></div>
            <div class="absolute inset-0 p-5 flex flex-col justify-end">
              <h3 class="text-lg md:text-xl font-bold tracking-tight">{a.label}</h3>
              <p class="text-[0.78rem] text-cream/60 mt-1 leading-snug">{a.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROGETTI SELEZIONATI ============ -->
  <section id="progetti-selezionati" class="u-container py-[var(--spacing-section)] scroll-mt-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <p class="u-eyebrow mb-4">Portfolio</p>
        <h2 class="text-[clamp(1.9rem,5vw,3.4rem)] font-extrabold tracking-tight">Progetti <span class="font-display italic font-normal">selezionati</span></h2>
      </div>
      <Button href="/progetti/" variant="ghost" arrow>Tutti i progetti</Button>
    </div>
    <div class="flex -mt-6 mb-4 sm:hidden">
      <button type="button" class="strip-hint" data-strip-next="selezionati-lista" aria-label="Scorri ai progetti successivi">Scorri <span class="strip-hint-arrow" aria-hidden="true">→</span></button>
    </div>
    <div id="selezionati-lista" class="m-strip grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-12">
      {featured.map((p, i) => <ProjectCard project={p} index={i} eager={i < 3} />)}
    </div>
  </section>

  
  <!-- ============ RECENSIONI ============ -->
  <Reviews />

  <!-- ============ CLIENTI ============ -->
  <Clients />
<script>
    import '../scripts/strip';
    // arrivo da un link con ancora (es. "Progetti selezionati" dalla pagina Progetti):
    // la sezione Metodo aggiunge altezza solo dopo il caricamento, quindi il salto si rifà dopo
    window.addEventListener("load", () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (target) setTimeout(() => target.scrollIntoView({ behavior: "instant" as ScrollBehavior, block: "start" }), 200);
    }, { once: true });

    // ---- hero: foto in ordine casuale (senza ripetizioni), crossfade lento + frecce ----
    const slides = Array.from(document.querySelectorAll<HTMLImageElement>(".hero-slide"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const load = (el: HTMLImageElement) => {
      if (!el.getAttribute("src")) { el.srcset = el.dataset.srcset || ""; el.src = el.dataset.src || ""; }
      return el.decode().catch(() => {});
    };
    if (slides.length > 1) {
      // sequenza mescolata una volta sola, a partire dalla foto scelta al caricamento:
      // "avanti" e "indietro" scorrono sempre la stessa sequenza
      const start = (window as unknown as { __heroStart?: number }).__heroStart ?? 0;
      const rest = slides.map((_, i) => i).filter((i) => i !== start);
      for (let i = rest.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [rest[i], rest[j]] = [rest[j], rest[i]]; }
      const order = [start, ...rest];
      let pos = 0;
      const at = (p: number) => slides[order[(p + order.length) % order.length]];
      const wrap = document.querySelector<HTMLElement>("[data-hero-slides]");
      let busy = false;

      const go = async (dir: 1 | -1, manual = false) => {
        if (busy) return;
        busy = true;
        const target = at(pos + dir);
        await load(target);
        // dal clic il cambio e piu rapido del crossfade automatico
        wrap?.classList.toggle("is-manual", manual);
        at(pos).classList.remove("is-active");
        target.classList.add("is-active");
        pos += dir;
        busy = false;
        // precarica le vicine, cosi le frecce rispondono subito
        setTimeout(() => { load(at(pos + 1)); load(at(pos - 1)); }, manual ? 300 : 2500);
      };

      let timer = 0;
      const startAuto = () => { clearInterval(timer); if (!reduceMotion && !document.hidden) timer = window.setInterval(() => go(1), 5000); };
      window.addEventListener("load", () => setTimeout(() => { load(at(1)); load(at(-1)); }, 1200), { once: true });
      startAuto();
      // pausa quando la scheda non e visibile (niente lavoro inutile)
      document.addEventListener("visibilitychange", startAuto);

      // il conteggio riparte da zero dopo ogni clic, per lasciare il tempo di guardare la foto
      document.querySelector("[data-hero-prev]")?.addEventListener("click", () => { go(-1, true); startAuto(); });
      document.querySelector("[data-hero-next]")?.addEventListener("click", () => { go(1, true); startAuto(); });

      // telefono: scorrendo il dito a destra o a sinistra sulla foto si passa alla precedente o alla successiva
      const hero = document.querySelector<HTMLElement>(".hero");
      let tx = 0, ty = 0;
      hero?.addEventListener("touchstart", (e) => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
      hero?.addEventListener("touchend", (e) => {
        const dx = e.changedTouches[0].clientX - tx, dy = e.changedTouches[0].clientY - ty;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) { go(dx < 0 ? 1 : -1, true); startAuto(); }
      }, { passive: true });
    }

    // scroll-linked hero: zoom contenuto sulla foto (1 -> 1.08), lieve rientro del contenuto
    const media = document.querySelector<HTMLElement>('[data-hero-media]');
    const content = document.querySelector<HTMLElement>('[data-hero-content]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (media && !reduce) {
      let ticking = false;
      const update = () => {
        const y = window.scrollY;
        const p = Math.min(y / (window.innerHeight * 0.9), 1);
        media.style.transform = `scale(${1 + p * 0.08})`;
        if (content) { content.style.transform = `translateY(${p * 26}px)`; content.style.opacity = String(1 - p * 0.6); }
        ticking = false;
      };
      window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
      update();
    }
  </script>

  <style>
    [data-hero-media] { will-change: transform; transform-origin: center; transition: transform 0.1s linear; }
    /* parole del titolo che portano ai progetti: si notano solo passandoci sopra (sottolineatura che si disegna) */
    .hero :global(.hero-word) {
      color: inherit; text-decoration: none;
      background: linear-gradient(currentColor, currentColor) 0 92% / 0 0.08em no-repeat;
      transition: background-size 0.45s var(--ease-out-expo);
    }
    .hero :global(.hero-word:hover), .hero :global(.hero-word:focus-visible) { background-size: 100% 0.08em; outline: none; }
    /* crossfade lento tra le foto dell'hero */
    .hero-slide { opacity: 0; transition: opacity 2.4s ease-in-out; }
    .hero-slide.is-active { opacity: 1; }
    [data-hero-slides].is-manual .hero-slide { transition-duration: 0.7s; }
    /* ambiti: foto in bianco e nero che si colora al passaggio del mouse (o con la tastiera) */
    .amb-card :global(.amb-img) { filter: grayscale(1) brightness(0.72); transform: scale(1); transition: filter 0.7s var(--ease-out-expo), transform 0.9s var(--ease-out-expo); }
    .amb-veil { transition: opacity 0.7s var(--ease-out-expo); }
    .amb-card:hover :global(.amb-img), .amb-card:focus-visible :global(.amb-img) { filter: grayscale(0) brightness(1); transform: scale(1.04); }
    .amb-card:hover .amb-veil, .amb-card:focus-visible .amb-veil { opacity: 0.55; }
    /* frecce ai lati della foto: solo la freccia, senza cerchio (richiesta del cliente), con un'ombra leggera per leggerla su ogni foto */
    .hero-arrow {
      position: absolute; top: 30%; z-index: 10; transform: translateY(-50%);
      display: grid; place-items: center; width: 2.75rem; height: 3.5rem;
      color: var(--color-cream); background: none; border: 0; cursor: pointer;
      filter: drop-shadow(0 1px 6px rgb(0 0 0 / 0.55));
      opacity: 0.85; transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .hero-arrow:hover { opacity: 1; }
    .hero-arrow[data-hero-prev]:hover { transform: translate(-3px, -50%); }
    .hero-arrow[data-hero-next]:hover { transform: translate(3px, -50%); }
    .hero-arrow:focus-visible { outline: 2px solid var(--color-cream); outline-offset: 3px; }
    /* telefono: le due frecce vicine in basso a destra, sotto i testi; le foto si cambiano anche facendo scorrere il dito */
    @media (max-width: 767px) {
      .hero-arrow { top: auto; bottom: 1.25rem; transform: none; width: 2.75rem; height: 2.75rem; }
      .hero-arrow[data-hero-prev] { left: auto; right: calc(clamp(1.25rem, 5vw, 3.5rem) + 2.1rem); }
      .hero-arrow[data-hero-next] { right: clamp(1.25rem, 5vw, 3.5rem); margin-right: -0.6rem; }
      .hero-arrow[data-hero-prev]:hover { transform: translateX(-3px); }
      .hero-arrow[data-hero-next]:hover { transform: translateX(3px); }
      .hero-arrow svg { width: 28px; height: 28px; }
    }
    /* da tablet in su: frecce a metà altezza, con spazio laterale per non coprire il titolo */
    @media (min-width: 768px) {
      .hero-arrow { top: 50%; width: 3.25rem; height: 4rem; }
      [data-hero-content] { padding-inline: max(clamp(1.25rem, 5vw, 3.5rem), calc(6rem - max(0px, (100vw - 84rem) / 2))); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slide { opacity: 0; }
      .hero-slide.is-active { opacity: 1; transition: none; }
    }
  </style>
</BaseLayout>
