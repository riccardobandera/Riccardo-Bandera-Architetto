---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProcessScroll from "../components/ProcessScroll.astro";
import Reviews from "../components/Reviews.astro";
import Clients from "../components/Clients.astro";
import Button from "../components/Button.astro";
import { getInEvidenza, getProgetto, coverOf, getHeroImages } from "../data/projects";
import { site, manifestoQuote, ambiti, homeTesti } from "../data/site";
import { servizi } from "../data/seo";

// hero: le foto con "Foto grande in home" attivo nel pannello, alternate a caso nel browser
const heroSlides = await Promise.all(
  (await getHeroImages()).map(async (h) => {
    const img = await getImage({ src: h.src, widths: [800, 1280, 1920], format: "webp" });
    const p = await getProgetto(h.slug);
    return { src: img.src, srcset: img.srcSet.attribute, alt: p ? `${p.data.titolo}, progetto di Riccardo Bandera Architetto` : "Progetto di Riccardo Bandera Architetto" };
  }),
);
const noscriptImg = heroSlides[0];

const featured = await getInEvidenza(6);

// copertine per gli ambiti: un progetto rappresentativo per ciascuno
const AMBITO_COVER: Record<string, string> = {
  residenziale: "c022-villa-con-affaccio-sul-lago-di-garda-realizzata-in-legno-a-verona-vr",
  commerciale: "pmt-panificio-moderno-in-piazza-lodron-bar-e-ristorazione-in-centro-a-trento-tn",
  alberghiero: "kkh-kono-kono-hotel-and-villas-a-zanzibar-tanzania",
  direzionale: "fbhq-uffici-brisa-a-bologna-bo",
};
const ambitiCards = (await Promise.all(
  ambiti.map(async (a) => {
    const p = await getProgetto(AMBITO_COVER[a.key]);
    const c = p ? coverOf(p) : null;
    return { ...a, cover: c?.src, alt: c?.alt ?? a.label };
  }),
)).filter((a) => a.cover);
---

<BaseLayout navMode="light" title={undefined}>
  <!-- ============ HERO ============ -->
  <section class="hero relative min-h-[100svh] flex items-end overflow-hidden bg-ink text-cream">
    <div class="hero-media absolute inset-0" data-hero-media>
      <div class="absolute inset-0" data-hero-slides>
        {heroSlides.map((s) => (
          <img class="hero-slide absolute inset-0 w-full h-full object-cover" data-src={s.src} data-srcset={s.srcset} sizes="100vw" alt={s.alt} decoding="async" />
        ))}
        <script is:inline>
          (function () {
            var s = document.querySelectorAll(".hero-slide");
            if (!s.length) return;
            var r = Math.floor(Math.random() * s.length), el = s[r];
            el.setAttribute("fetchpriority", "high");
            el.srcset = el.getAttribute("data-srcset"); el.src = el.getAttribute("data-src");
            el.classList.add("is-active"); window.__heroStart = r;
          })();
        </script>
        <noscript><img class="absolute inset-0 w-full h-full object-cover" src={noscriptImg.src} srcset={noscriptImg.srcset} sizes="100vw" alt={noscriptImg.alt} /></noscript>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-ink/40"></div>
    </div>

    <!-- frecce: foto precedente / successiva -->
    {heroSlides.length > 1 && (
      <>
        <button type="button" class="hero-arrow left-3 md:left-6" data-hero-prev aria-label="Foto precedente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="hero-arrow right-3 md:right-6" data-hero-next aria-label="Foto successiva">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </>
    )}

    <div class="u-container relative pb-16 md:pb-24 pt-32 w-full" data-hero-content>
      <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(2rem,6.4vw,5.4rem)] max-w-[16ch]">
        {site.tagline}
      </h1>
      <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <Button href="/progetti/" variant="onDark" arrow>Scopri i progetti</Button>
        <p class="max-w-md text-cream/75 text-[0.98rem] leading-relaxed">{homeTesti.sottotitolo}</p>
      </div>
    </div>
  </section>

  <!-- ============ MANIFESTO QUOTE ============ -->
  <!-- z-10: la sezione Metodo sotto risale di qualche riga (vedi -mt in ProcessScroll) e non deve coprire pulsante e riga -->
  <section class="u-container relative z-10 pt-20 md:pt-28">
    <div class="max-w-4xl mx-auto">
      <div class="text-center reveal">
        <blockquote class="font-display text-[clamp(1.5rem,3.4vw,2.6rem)] leading-[1.28] text-ink">
          {manifestoQuote}
        </blockquote>
        <div class="mt-10 flex justify-center">
          <Button href="/manifesto/" variant="ghost" arrow>Leggi il manifesto</Button>
        </div>
      </div>
    </div>
    <!-- riga divisoria tra manifesto e metodo -->
    <div class="mt-14 md:mt-16 grow-line h-px w-full bg-ink/20" aria-hidden="true"></div>
  </section>

  <!-- ============ LE 6 FASI (scroll orizzontale) ============ -->
  <ProcessScroll />

  <!-- ============ AMBITI (dark) ============ -->
  <section class="bg-ink text-cream py-[var(--spacing-section)]">
    <div class="u-container">
      <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <h2 class="text-[clamp(1.9rem,5vw,3.4rem)] font-extrabold tracking-tight uppercase">Ambiti d’intervento</h2>
        <p class="max-w-sm text-cream/60 leading-relaxed">Quattro campi, un unico metodo. Ogni progetto nasce dal luogo e dalle persone che lo vivono.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {ambitiCards.map((a, i) => (
          <a href={`/progetti/?ambito=${a.key}`} class="group relative overflow-hidden aspect-[3/4] bg-white/5 reveal" data-reveal-delay={(i % 4) + 1}>
            {a.cover && (
              <Image src={a.cover} alt={a.alt ?? a.label} widths={[300, 500, 700]} sizes="(max-width:1024px) 46vw, 24vw"
                class="w-full h-full object-cover grayscale opacity-70 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-[1.04]" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent"></div>
            <div class="absolute inset-0 p-5 flex flex-col justify-end">
              <h3 class="text-lg md:text-xl font-bold tracking-tight">{a.label}</h3>
              <p class="text-[0.78rem] text-cream/60 mt-1 leading-snug">{a.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <!-- pagine per settore (link interni per Google e per chi cerca un tipo di lavoro preciso) -->
      <div class="mt-10 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
        <p class="u-eyebrow text-cream/50 shrink-0">Specializzazioni</p>
        <ul class="flex flex-wrap gap-2.5">
          {servizi.map((s) => (
            <li><a href={`/${s.slug}/`} class="inline-block border border-white/20 rounded-full px-4 py-2 text-sm text-cream/85 hover:bg-cream hover:text-ink transition-colors">{s.nome}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ PROGETTI SELEZIONATI ============ -->
  <section id="progetti-selezionati" class="u-container py-[var(--spacing-section)] scroll-mt-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <p class="u-eyebrow mb-4">Portfolio</p>
        <h2 class="text-[clamp(1.9rem,5vw,3.4rem)] font-extrabold tracking-tight">Progetti <span class="font-display italic font-normal">selezionati</span></h2>
      </div>
      <Button href="/progetti/" variant="ghost" arrow>Tutti i progetti</Button>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-12">
      {featured.map((p, i) => <ProjectCard project={p} index={i} eager={i < 3} />)}
    </div>
  </section>

  
  <!-- ============ RECENSIONI ============ -->
  <Reviews />

  <!-- ============ CLIENTI ============ -->
  <Clients />
<script>
    // arrivo da un link con ancora (es. "Progetti selezionati" dalla pagina Progetti):
    // la sezione Metodo aggiunge altezza solo dopo il caricamento, quindi il salto si rifà dopo
    window.addEventListener("load", () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (target) setTimeout(() => target.scrollIntoView({ behavior: "instant" as ScrollBehavior, block: "start" }), 200);
    }, { once: true });

    // ---- hero: foto in ordine casuale (senza ripetizioni), crossfade lento + frecce ----
    const slides = Array.from(document.querySelectorAll<HTMLImageElement>(".hero-slide"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const load = (el: HTMLImageElement) => {
      if (!el.getAttribute("src")) { el.srcset = el.dataset.srcset || ""; el.src = el.dataset.src || ""; }
      return el.decode().catch(() => {});
    };
    if (slides.length > 1) {
      // sequenza mescolata una volta sola, a partire dalla foto scelta al caricamento:
      // "avanti" e "indietro" scorrono sempre la stessa sequenza
      const start = (window as unknown as { __heroStart?: number }).__heroStart ?? 0;
      const rest = slides.map((_, i) => i).filter((i) => i !== start);
      for (let i = rest.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [rest[i], rest[j]] = [rest[j], rest[i]]; }
      const order = [start, ...rest];
      let pos = 0;
      const at = (p: number) => slides[order[(p + order.length) % order.length]];
      const wrap = document.querySelector<HTMLElement>("[data-hero-slides]");
      let busy = false;

      const go = async (dir: 1 | -1, manual = false) => {
        if (busy) return;
        busy = true;
        const target = at(pos + dir);
        await load(target);
        // dal clic il cambio e piu rapido del crossfade automatico
        wrap?.classList.toggle("is-manual", manual);
        at(pos).classList.remove("is-active");
        target.classList.add("is-active");
        pos += dir;
        busy = false;
        // precarica le vicine, cosi le frecce rispondono subito
        setTimeout(() => { load(at(pos + 1)); load(at(pos - 1)); }, manual ? 300 : 2500);
      };

      let timer = 0;
      const startAuto = () => { clearInterval(timer); if (!reduceMotion && !document.hidden) timer = window.setInterval(() => go(1), 5000); };
      window.addEventListener("load", () => setTimeout(() => { load(at(1)); load(at(-1)); }, 1200), { once: true });
      startAuto();
      // pausa quando la scheda non e visibile (niente lavoro inutile)
      document.addEventListener("visibilitychange", startAuto);

      // il conteggio riparte da zero dopo ogni clic, per lasciare il tempo di guardare la foto
      document.querySelector("[data-hero-prev]")?.addEventListener("click", () => { go(-1, true); startAuto(); });
      document.querySelector("[data-hero-next]")?.addEventListener("click", () => { go(1, true); startAuto(); });
    }

    // scroll-linked hero: zoom contenuto sulla foto (1 -> 1.08), lieve rientro del contenuto
    const media = document.querySelector<HTMLElement>('[data-hero-media]');
    const content = document.querySelector<HTMLElement>('[data-hero-content]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (media && !reduce) {
      let ticking = false;
      const update = () => {
        const y = window.scrollY;
        const p = Math.min(y / (window.innerHeight * 0.9), 1);
        media.style.transform = `scale(${1 + p * 0.08})`;
        if (content) { content.style.transform = `translateY(${p * 26}px)`; content.style.opacity = String(1 - p * 0.6); }
        ticking = false;
      };
      window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
      update();
    }
  </script>

  <style>
    [data-hero-media] { will-change: transform; transform-origin: center; transition: transform 0.1s linear; }
    /* crossfade lento tra le foto dell'hero */
    .hero-slide { opacity: 0; transition: opacity 2.4s ease-in-out; }
    .hero-slide.is-active { opacity: 1; }
    [data-hero-slides].is-manual .hero-slide { transition-duration: 0.7s; }
    /* frecce ai lati della foto */
    .hero-arrow {
      position: absolute; top: 30%; z-index: 10; transform: translateY(-50%);
      display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 9999px;
      color: var(--color-cream); background: rgb(20 20 20 / 0.28); border: 1px solid rgb(240 237 230 / 0.45);
      backdrop-filter: blur(6px); cursor: pointer;
      transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    }
    .hero-arrow:hover { background: var(--color-cream); color: var(--color-ink); border-color: var(--color-cream); }
    .hero-arrow:focus-visible { outline: 2px solid var(--color-cream); outline-offset: 3px; }
    /* da tablet in su: frecce a metà altezza, con spazio laterale per non coprire il titolo */
    @media (min-width: 768px) {
      .hero-arrow { top: 50%; width: 3.25rem; height: 3.25rem; }
      [data-hero-content] { padding-inline: max(clamp(1.25rem, 5vw, 3.5rem), calc(6rem - max(0px, (100vw - 84rem) / 2))); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slide { opacity: 0; }
      .hero-slide.is-active { opacity: 1; transition: none; }
    }
  </style>
</BaseLayout>
