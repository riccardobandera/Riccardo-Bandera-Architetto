---
// Pagina di un'attivita dello studio (sanatorie, Salva Casa, pre-pareri...).
// Esiste solo quando nel pannello c'e il testo (Testi e dati > Testi delle pagine > Altre attivita):
// i testi li scrive lo studio, qui non si inventa nulla.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { altreAttivita } from '../../data/site';

export function getStaticPaths() {
  return altreAttivita.schede.filter((s) => s.href).map((s) => ({ params: { slug: s.slug }, props: { scheda: s } }));
}

const { scheda } = Astro.props;
// paragrafi separati da una riga vuota; un a capo semplice resta a capo
const paragrafi = scheda.testo.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const primo = paragrafi[0].replace(/\s+/g, ' ');
const descrizione = scheda.descrizione || (primo.length <= 155 ? primo : primo.slice(0, 155).replace(/\s\S*$/, '') + '…');

// articoli del Journal collegati a questa attivita (campo "Collega a un'attivita" dell'articolo)
const articoli = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.attivita === scheda.titolo)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('it-IT', { day: '2-digit', month: 'long', year: 'numeric' });
const altre = altreAttivita.schede.filter((s) => s.slug !== scheda.slug);
---
<BaseLayout title={scheda.titolo} description={descrizione}>
  <article class="u-container pt-36 md:pt-44 pb-[var(--spacing-section)]">
    <div class="max-w-3xl">
      <p class="u-eyebrow mb-6"><a href="/fasi-del-progetto/#altre-attivita" class="hover:text-ink">Altre attività dello studio</a></p>
      <h1 class="text-[clamp(2rem,5vw,3.6rem)] font-extrabold tracking-tight leading-[1.04]">{scheda.titolo}</h1>
      <div class="mt-10 space-y-5 text-[1.08rem] leading-[1.8] text-ink/90">
        {paragrafi.map((p) => <p set:html={p.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br />')} />)}
      </div>
      <div class="mt-12 flex flex-wrap gap-4">
        <Button href="/contatti/" variant="solid" arrow>Parliamone</Button>
        <Button href="/fasi-del-progetto/" variant="ghost">Come lavoriamo</Button>
      </div>
    </div>

    {articoli.length > 0 && (
      <section class="mt-20 border-t border-line pt-10" aria-labelledby="approfondimenti">
        <h2 id="approfondimenti" class="u-eyebrow mb-6">Approfondimenti dal Journal</h2>
        <ul class="divide-y divide-line border-y border-line">
          {articoli.map((a) => (
            <li>
              <a href={`/blog/${a.id}/`} class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-8 py-5">
                <time class="u-eyebrow shrink-0 md:w-44" datetime={a.data.date.toISOString()}>{fmt(a.data.date)}</time>
                <span class="text-lg font-bold tracking-tight group-hover:opacity-60 transition-opacity">{a.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-20 border-t border-line pt-10" aria-labelledby="altre-attivita-elenco">
      <h2 id="altre-attivita-elenco" class="u-eyebrow mb-6">Altre attività</h2>
      <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-3 text-[1rem] leading-snug">
        {altre.map((s) => (
          <li>{s.href ? <a href={s.href} class="u-underline">{s.titolo}</a> : <span class="text-muted">{s.titolo}</span>}</li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
