---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
// anteprima: immagine della mappa usata sul sito precedente
import mappa from '../images/pagine/mappa-studio.webp';
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.zip} ${site.address.city}`);
---
<BaseLayout title="Contatti" description="Contatta lo studio Riccardo Bandera Architetto a Mestre (Venezia). Raccontaci del tuo progetto.">
  <section class="u-container pt-36 md:pt-44 pb-12">
    <p class="u-eyebrow mb-6 reveal">Contatti</p>
    <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(2.2rem,7vw,5.4rem)] max-w-[16ch] reveal">
      Ci piacerebbe sentire la tua opinione.
    </h1>
    <p class="mt-8 max-w-xl text-muted text-lg leading-relaxed reveal">
      Chiamaci, inviaci un messaggio o trovaci sui social. Ti risponderemo al più presto.
    </p>
  </section>

  <section class="u-container pb-[var(--spacing-section)]">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- info -->
      <aside class="lg:col-span-4 space-y-10">
        <div class="reveal">
          <p class="u-eyebrow mb-3">Indirizzo</p>
          <p class="text-lg leading-relaxed">{site.address.street}<br />{site.address.zip} {site.address.city}, {site.address.region}</p>
        </div>
        <div class="reveal">
          <p class="u-eyebrow mb-3">Telefono</p>
          <a href={`tel:${site.phoneOfficeHref}`} class="text-lg u-underline block w-fit">{site.phoneOffice}</a>
          <a href={`tel:${site.phoneHref}`} class="text-lg u-underline block w-fit">{site.phone}</a>
        </div>
        <div class="reveal">
          <p class="u-eyebrow mb-3">Email</p>
          <a href={`mailto:${site.email}`} class="text-lg u-underline block w-fit">{site.email}</a>
          <a href={`mailto:${site.pec}`} class="text-sm text-muted u-underline block w-fit mt-1">PEC {site.pec}</a>
        </div>
        <div class="reveal">
          <p class="u-eyebrow mb-3">Social</p>
          <div class="flex gap-5 text-lg">
            <a href={site.social.instagram} target="_blank" rel="noopener" class="u-underline">Instagram</a>
            <a href={site.social.facebook} target="_blank" rel="noopener" class="u-underline">Facebook</a>
            <a href={site.social.linkedin} target="_blank" rel="noopener" class="u-underline">LinkedIn</a>
          </div>
        </div>
      </aside>

      <!-- form -->
      <div class="lg:col-span-8 reveal">
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- mappa: anteprima statica, la mappa Google si carica solo al clic (piu veloce, niente cookie di terzi) -->
  <section class="relative w-full h-[45vh] bg-surface border-t border-line overflow-hidden" data-map>
    <Image src={mappa} alt={`Mappa della sede: ${site.address.street}, ${site.address.city}`} widths={[800, 1280, 1600]} sizes="100vw" class="absolute inset-0 w-full h-full object-cover grayscale" loading="lazy" />
    <div class="absolute inset-0 grid place-items-center bg-bg/30">
      <div class="flex flex-wrap justify-center gap-3">
        <button type="button" class="btn btn--solid" data-map-load>Apri la mappa interattiva</button>
        <a href={site.googleMaps} target="_blank" rel="noopener" class="btn btn--ghost bg-bg">Indicazioni su Google Maps</a>
      </div>
    </div>
  </section>
  <p class="u-container py-3 text-xs text-muted">La mappa interattiva è fornita da Google Maps e viene caricata solo dopo il clic.</p>
  <script define:vars={{ src: `https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`, title: `Mappa: ${site.address.street}, ${site.address.city}` }}>
    document.querySelector("[data-map-load]")?.addEventListener("click", () => {
      const wrap = document.querySelector("[data-map]");
      const f = document.createElement("iframe");
      f.src = src; f.title = title; f.className = "absolute inset-0 w-full h-full grayscale"; f.loading = "lazy"; f.referrerPolicy = "no-referrer-when-downgrade";
      wrap.replaceChildren(f);
    });
  </script>
</BaseLayout>
