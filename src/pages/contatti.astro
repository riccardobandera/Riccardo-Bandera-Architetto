---
import { seoPagina } from '../data/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
// la mappa cerca la scheda Google dello studio (nome + indirizzo), cosi il riquadro mostra "Riccardo Bandera Architetto"
const mapQuery = encodeURIComponent(`${site.legalName}, ${site.address.street}, ${site.address.zip} ${site.address.city}`);
---
<BaseLayout {...seoPagina('contatti')}>
  <section class="u-container pt-36 md:pt-44 pb-12">
    <p class="u-eyebrow mb-6 reveal">Contatti</p>
    <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(2.2rem,7vw,5.4rem)] max-w-[16ch] reveal">
      Ci piacerebbe sentire la tua opinione.
    </h1>
    <p class="mt-8 max-w-xl text-muted text-lg leading-relaxed reveal">
      Chiamaci, inviaci un messaggio o trovaci sui social. Ti risponderemo al più presto.
    </p>
  </section>

  <section class="u-container pb-[var(--spacing-section)]">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- info -->
      <aside class="lg:col-span-4 space-y-10">
        <div class="reveal">
          <p class="u-eyebrow mb-3">Indirizzo</p>
          <p class="text-lg leading-relaxed">{site.address.street}<br />{site.address.zip} {site.address.city}, {site.address.region}</p>
        </div>
        <div class="reveal">
          <p class="u-eyebrow mb-3">Telefono</p>
          <a href={`tel:${site.phoneHref}`} class="text-lg u-underline block w-fit">{site.phone}</a>
        </div>
        <div class="reveal">
          <p class="u-eyebrow mb-3">Email</p>
          <a href={`mailto:${site.email}`} class="text-lg u-underline block w-fit">{site.email}</a>
          <a href={`mailto:${site.pec}`} class="text-sm text-muted u-underline block w-fit mt-1">PEC {site.pec}</a>
        </div>
        <div class="reveal">
          <p class="u-eyebrow mb-3">Social</p>
          <div class="flex gap-5 text-lg">
            <a href={site.social.instagram} target="_blank" rel="noopener" class="u-underline">Instagram</a>
            <a href={site.social.facebook} target="_blank" rel="noopener" class="u-underline">Facebook</a>
            <a href={site.social.linkedin} target="_blank" rel="noopener" class="u-underline">LinkedIn</a>
          </div>
        </div>
      </aside>

      <!-- form -->
      <div class="lg:col-span-8 reveal">
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- mappa Google della sede: si carica da sola se il visitatore ha acconsentito ai contenuti di terze parti
       (banner dei cookie); altrimenti un riquadro spiega e permette di caricarla con un clic -->
  <section class="relative w-full h-[45vh] bg-surface border-t border-line overflow-hidden" data-mappa-google>
    <div class="absolute inset-0 grid place-items-center p-6 text-center" data-mappa-avviso>
      <div class="max-w-md">
        <p class="font-bold">{site.legalName}</p>
        <p class="mt-1 text-sm text-muted">{site.address.street}, {site.address.zip} {site.address.city} ({site.address.region})</p>
        <p class="mt-5 text-sm text-ink/80 leading-relaxed">La mappa è fornita da Google Maps, che può impostare propri cookie. La carichiamo solo con il tuo consenso.</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <button type="button" class="btn btn--solid" data-consenti-mappa>Carica la mappa</button>
          <a href={site.googleMaps} target="_blank" rel="noopener" class="btn btn--ghost">Apri in Google Maps</a>
        </div>
      </div>
    </div>
    <iframe
      data-src={`https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`}
      hidden
      title={`Mappa: ${site.legalName}, ${site.address.street}, ${site.address.city}`}
      class="absolute inset-0 w-full h-full grayscale"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</BaseLayout>

<script>
  // la mappa si carica solo con il consenso ai contenuti di terze parti
  const box = document.querySelector<HTMLElement>('[data-mappa-google]');
  const frame = box?.querySelector<HTMLIFrameElement>('iframe[data-src]');
  const avviso = box?.querySelector<HTMLElement>('[data-mappa-avviso]');
  const mostra = () => {
    if (!frame || frame.src) return;
    frame.src = frame.dataset.src!;
    frame.hidden = false;
    if (avviso) avviso.hidden = true;
  };
  const nascondi = () => {
    if (!frame) return;
    frame.removeAttribute('src');
    frame.hidden = true;
    if (avviso) avviso.hidden = false;
  };
  const decidi = (s: { maps?: boolean } | null) => (s?.maps ? mostra() : nascondi());
  window.addEventListener('rb-consenso', (e) => decidi((e as CustomEvent).detail));
  decidi((window as unknown as { rbConsenso?: () => { maps?: boolean } | null }).rbConsenso?.() ?? null);
</script>
