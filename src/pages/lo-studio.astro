---
import { seoPagina } from '../data/seo';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import StudioInBreve from '../components/StudioInBreve.astro';
import LaRete from '../components/LaRete.astro';
import { studioBio, studioFirma, team, studioTitolo, site, ORG_ID, PERSON_ID } from '../data/site';

// ritratti reali del team (nell'ordine della sezione originale)
import pRiccardo from '../images/team/RB_Front-800x1000.png';
import pAldo from '../images/team/Adobe-Express-file-768x960.png';
import pThomas from '../images/team/Adobe-Express-file-3-800x1000.png';
import pMarco from '../images/team/Adobe-Express-file-2-800x1000.png';
import pEleonora from '../images/team/eleonora-reato-architetto.webp';
// ritratti per nome (non per posizione: aggiungendo persone l'ordine puo cambiare)
const ritratti: [RegExp, typeof pRiccardo][] = [[/riccardo/i, pRiccardo], [/aldo/i, pAldo], [/thomas/i, pThomas], [/eleonora/i, pEleonora], [/marco/i, pMarco]];
const teamWithPhotos = team.map((m) => ({ ...m, photo: ritratti.find(([re]) => re.test(m.name))?.[1] }));

import portrait from '../images/team/riccardo-bandera-architetto.webp';

// la pagina descrive lo studio e il suo titolare (prima c'era una pagina "in breve" separata)
const url = new URL('/lo-studio/', site.url).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'AboutPage', '@id': url, url, name: seoPagina('studio').title, inLanguage: 'it-IT', mainEntity: { '@id': PERSON_ID }, about: { '@id': ORG_ID } },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Lo studio', item: url },
    ],
  },
];
---
<BaseLayout {...seoPagina('studio')} jsonLd={jsonLd}>
  <section class="u-container pt-36 md:pt-44 pb-16">
    <p class="u-eyebrow mb-6 reveal">Lo Studio</p>
    <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(2.2rem,7vw,5.4rem)] max-w-[15ch] reveal">{studioTitolo}</h1>
  </section>

  <section class="u-container pb-[var(--spacing-section)]">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- il ritratto resta fermo mentre si legge il testo accanto (niente vuoto a sinistra) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start reveal">
        {portrait && <Image src={portrait} alt="Ritratto dell'architetto Riccardo Bandera" widths={[500, 800, 1000]} sizes="(max-width:1024px) 100vw, 40vw" class="w-full aspect-[4/5] object-cover" />}
      </div>
      <div class="lg:col-span-7 lg:pt-6">
        <div class="space-y-6 text-[1.08rem] leading-relaxed text-ink/90 max-w-2xl">
          {studioBio.map((p, i) => (
            <p class:list={['reveal', i === 0 && 'text-[clamp(1.35rem,2.2vw,1.7rem)] leading-snug text-ink font-medium']}>{p}</p>
          ))}
          {studioFirma && <p class="reveal font-display text-[1.6rem] text-ink">{studioFirma}</p>}
        </div>
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href="/progetti/" variant="ghost" arrow>I progetti</Button>
          <Button href="/manifesto/" variant="ghost">Il manifesto</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- team -->
  <section class="bg-surface py-[var(--spacing-section)]">
    <div class="u-container">
      <div class="flex items-end justify-between mb-12">
        <h2 class="text-[clamp(1.8rem,4.5vw,3rem)] font-extrabold tracking-tight">Il team</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
        {teamWithPhotos.map((m, i) => (
          <figure class="team-card group reveal" data-reveal-delay={(i % 4) + 1}>
            <div class="relative overflow-hidden bg-bg aspect-[4/5]">
              {m.photo ? (
              <Image
                src={m.photo}
                alt={`Ritratto di ${m.name}`}
                widths={[300, 500, 700]}
                sizes="(max-width:1024px) 46vw, 22vw"
                class="team-img w-full h-full object-cover object-top"
              />
              ) : (
              <span class="absolute inset-0 grid place-items-center font-display text-5xl text-muted/60">{m.name.replace(/^arch.s*/i, "").split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase()}</span>
              )}
            </div>
            <figcaption class="pt-3">
              <h3 class="text-[0.95rem] font-bold tracking-tight capitalize">{m.name}</h3>
              <p class="text-sm text-muted mt-0.5">{m.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <LaRete />

  <!-- lo studio in breve: pannello che si apre con la freccia -->
  <section id="in-breve" class="border-t border-line scroll-mt-24">
    <div class="u-container">
      <button type="button" class="inbreve-toggle group w-full flex items-center justify-between gap-6 py-8 md:py-10 text-left" aria-expanded="false" aria-controls="in-breve-panel" data-inbreve-toggle>
        <span>
          <span class="u-eyebrow block mb-2">Scheda, zone, elenco dei progetti</span>
          <span class="block text-[clamp(1.4rem,3vw,2rem)] font-extrabold tracking-tight">Lo studio in breve</span>
        </span>
        <svg class="inbreve-chevron shrink-0" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
      </button>
    </div>
    <div id="in-breve-panel" class="inbreve-panel" data-inbreve-panel>
      <div class="inbreve-inner"><StudioInBreve /></div>
    </div>
  </section>

</BaseLayout>

<script>
  // "Lo studio in breve": si apre e si chiude con la freccia; aperto da subito se il link porta a #in-breve
  const btn = document.querySelector<HTMLButtonElement>('[data-inbreve-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-inbreve-panel]');
  if (btn && panel) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    if (location.hash === '#in-breve') set(true);
  }
</script>

<style>
  .inbreve-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.7s var(--ease-out-expo); }
  .inbreve-panel.is-open { grid-template-rows: 1fr; }
  .inbreve-inner { overflow: hidden; min-height: 0; }
  .inbreve-chevron { transition: transform 0.5s var(--ease-out-expo); }
  .inbreve-toggle[aria-expanded='true'] .inbreve-chevron { transform: rotate(180deg); }
  .inbreve-toggle:hover .inbreve-chevron { transform: translateY(3px); }
  .inbreve-toggle[aria-expanded='true']:hover .inbreve-chevron { transform: rotate(180deg) translateY(3px); }
  /* team: in bianco e nero, a colori al passaggio del mouse (o con la tastiera) */
  .team-card :global(.team-img) { filter: grayscale(1); opacity: 0.95; transform: scale(1); transition: filter 0.8s var(--ease-out-expo), opacity 0.8s var(--ease-out-expo), transform 0.9s var(--ease-out-expo); }
  .team-card:hover :global(.team-img), .team-card:focus-within :global(.team-img) { filter: grayscale(0); opacity: 1; transform: scale(1.04); }
  .inbreve-toggle:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .inbreve-panel, .inbreve-chevron { transition: none; } }
</style>
