---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { getProgetti, adjacent, catLabels, matLabels, coverOf, type Progetto } from '../../data/projects';
import { site, ORG_ID, PERSON_ID } from '../../data/site';
import { servizi } from '../../data/seo';

export async function getStaticPaths() {
  const all = await getProgetti();
  return all.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props as { project: Progetto };
const d = project.data;
const { Content } = await render(project);
const nav = await adjacent(project.id);
const cover = coverOf(project);
// copertina verticale o quadrata: in pagina si vede intera (alta al massimo come lo schermo), non tagliata a fascia
const coverAlta = !!cover && cover.src.height >= cover.src.width * 0.9;
const cats = d.categorie.map((c) => catLabels[c]);
const mats = d.materiali.map((m) => matLabels[m]);

const sezioni = [
  { key: 'foto', titolo: 'Fotografie', items: d.foto, variant: 'foto' as const },
  { key: 'render', titolo: 'Render', items: d.render, variant: 'foto' as const },
  { key: 'disegni', titolo: 'Disegni', items: d.disegni, variant: 'disegni' as const },
  { key: 'cantiere', titolo: 'Cantiere', items: d.cantiere, variant: 'foto' as const },
].filter((s) => s.items.length);

// SEO: descrizione dal testo del progetto
const plain = (project.body ?? '').replace(/\s+/g, ' ').trim();
const desc = d.seo?.descrizione || (plain.length > 20 ? plain.slice(0, 152).replace(/\s\S*$/, '') + '…' : `${d.titolo}. Progetto di Riccardo Bandera Architetto.`);
const seoTitle = d.seo?.titolo || d.titolo;
// testo lungo: oltre ~900 caratteri si accorcia, il resto si apre con "Continua a leggere"
const lungo = plain.length > 900;
// pagine per settore che citano questo progetto (link interni)
const settori = servizi.filter((s) => d.codice && s.progetti.includes(d.codice.toUpperCase()));
const ogImg = cover ? await getImage({ src: cover.src, width: 1200, format: 'jpg' }) : null;
const imgs = await Promise.all([...d.foto, ...d.render].slice(0, 8).map((i) => getImage({ src: i.src, width: 1200, format: 'jpg' })));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': new URL(`/progetti/${project.id}/`, site.url).href,
  name: d.titolo,
  headline: d.titolo,
  description: plain.slice(0, 500) || d.titolo,
  url: new URL(`/progetti/${project.id}/`, site.url).href,
  inLanguage: 'it-IT',
  ...(d.anno ? { dateCreated: String(d.anno) } : {}),
  creator: { '@id': PERSON_ID },
  author: { '@id': ORG_ID },
  ...(d.luogo ? { locationCreated: { '@type': 'Place', name: d.luogo, ...(d.coordinate ? { geo: { '@type': 'GeoCoordinates', latitude: d.coordinate.lat, longitude: d.coordinate.lng } } : {}) } } : {}),
  keywords: [...d.tag, ...cats, ...mats, 'architetto', 'Riccardo Bandera'].join(', '),
  image: imgs.map((i) => new URL(i.src, site.url).href),
  genre: cats.join(', '),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Progetti', item: new URL('/progetti/', site.url).href },
    { '@type': 'ListItem', position: 2, name: d.titolo, item: new URL(`/progetti/${project.id}/`, site.url).href },
  ],
};
---
<BaseLayout title={seoTitle} description={desc} image={ogImg?.src} type="article" jsonLd={[jsonLd, breadcrumbLd]}>
  <div data-project-modal data-slug={project.id}>
    <!-- intestazione -->
    <section class="u-container pt-32 md:pt-40 pb-8">
      <nav class="text-xs text-muted tracking-[0.12em] uppercase mb-8 flex flex-wrap items-center gap-2 reveal" aria-label="Percorso">
        <a href="/progetti/" class="u-underline">Progetti</a>
        {cats[0] && <><span>/</span><a href={`/progetti/?ambito=${d.categorie[0]}`} class="u-underline">{cats[0]}</a></>}
      </nav>
      <h1 class="text-[clamp(1.9rem,5vw,4rem)] font-extrabold tracking-tight leading-[1.02] max-w-[22ch] reveal">{d.titolo}</h1>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[0.75rem] uppercase tracking-[0.14em] text-muted reveal">
        {d.luogo && <span>{d.luogo}</span>}
        {d.anno && <span>{d.anno}</span>}
        {cats.length > 0 && <span>{cats.join(', ')}</span>}
      </div>
    </section>

    {cover && (
      <section class="u-container pb-12">
        <!-- clic sulla copertina: si apre la galleria delle immagini a schermo intero -->
        <button type="button" class:list={['cover-open', coverAlta && 'cover-open--alta']} data-open-gallery aria-label="Apri la galleria delle immagini">
          <Image src={cover.src} alt={cover.alt} widths={[768, 1280, 1920]} sizes="(max-width: 1400px) 94vw, 1300px" loading="eager" fetchpriority="high" class:list={[coverAlta ? 'w-auto h-auto max-w-full max-h-[78vh]' : 'w-full max-h-[78vh] object-cover']} />
        </button>
      </section>
    )}

    <!-- testo + scheda -->
    <section class="u-container pb-16 md:pb-24">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-7">
          <div class:list={['reveal', lungo && 'testo-lungo']} data-more>
            <div class="prose-progetto"><Content /></div>
            {lungo && (
              <button type="button" class="testo-toggle" data-more-toggle aria-expanded="false">
                <span data-more-label>Continua a leggere</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
              </button>
            )}
          </div>
          {d.tag.length > 0 && (
            <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tag">
              {d.tag.map((t) => <li class="text-[0.7rem] uppercase tracking-[0.12em] text-muted border border-line rounded-full px-3 py-1.5">{t}</li>)}
            </ul>
          )}
        </div>
        <aside class="lg:col-span-5">
          <p class="u-eyebrow mb-3 reveal">Scheda del progetto</p>
          <dl class="scheda text-sm reveal">
            {d.luogo && <div><dt>Luogo</dt><dd>{d.luogo}</dd></div>}
            {d.indirizzo && <div><dt>Indirizzo</dt><dd><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.indirizzo)}`} target="_blank" rel="noopener" class="u-underline">{d.indirizzo}</a></dd></div>}
            {d.anno && <div><dt>Anno</dt><dd>{d.anno}</dd></div>}
            {cats.length > 0 && <div><dt>Ambito</dt><dd>{cats.join(', ')}</dd></div>}
            {mats.length > 0 && <div><dt>Materiali</dt><dd>{mats.join(', ')}</dd></div>}
            {d.stato && <div><dt>Stato</dt><dd>{d.stato === 'realizzato' ? 'Realizzato' : 'In progetto'}</dd></div>}
          </dl>
          {settori.length > 0 && (
            <p class="mt-8 text-sm reveal">
              <span class="u-eyebrow block mb-2">Altri progetti simili</span>
              {settori.map((s, i) => <>{i > 0 && ', '}<a href={`/${s.slug}/`} class="u-underline font-medium">{s.h1}</a></>)}
            </p>
          )}
        </aside>
      </div>
    </section>

    <!-- gallerie -->
    {sezioni.map((s, idx) => (
      <section class="u-container pb-16 md:pb-24">
        <div class="flex items-baseline justify-between border-t border-line pt-6 mb-8">
          <h2 class="text-[clamp(1.3rem,2.6vw,1.9rem)] font-bold tracking-tight">{s.titolo}</h2>
          <span class="u-eyebrow">{s.items.length} {s.items.length === 1 ? 'immagine' : 'immagini'}</span>
        </div>
        <Gallery images={s.items} id={`g-${s.key}-${project.id}`} variant={s.variant} eagerFirst={idx === 0 && !cover} />
      </section>
    ))}

    <!-- crediti: chi ha fatto il progetto, in fondo dopo le immagini -->
    {d.crediti.length > 0 && (
      <section class="u-container pb-16 md:pb-24">
        <div class="flex items-baseline justify-between border-t border-line pt-6 mb-8">
          <h2 class="text-[clamp(1.3rem,2.6vw,1.9rem)] font-bold tracking-tight">Crediti</h2>
        </div>
        <dl class="crediti grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
          {d.crediti.map((c) => (
            <div class="py-4 border-b border-line">
              <dt class="text-[0.72rem] uppercase tracking-[0.12em] text-muted mb-1">{c.ruolo}</dt>
              <dd class="font-medium leading-snug">{c.nome}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </div>

  {nav && (
    <section class="border-t border-line">
      <div class="u-container grid grid-cols-2">
        <a href={`/progetti/${nav.prev.id}/`} class="group py-10 md:py-14 pr-4">
          <span class="u-eyebrow flex items-center gap-2 mb-3"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg> Precedente</span>
          <span class="block text-base md:text-2xl font-bold tracking-tight group-hover:opacity-60 transition-opacity">{nav.prev.data.titolo}</span>
        </a>
        <a href={`/progetti/${nav.next.id}/`} class="group py-10 md:py-14 pl-4 text-right border-l border-line">
          <span class="u-eyebrow flex items-center justify-end gap-2 mb-3">Successivo <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></span>
          <span class="block text-base md:text-2xl font-bold tracking-tight group-hover:opacity-60 transition-opacity">{nav.next.data.titolo}</span>
        </a>
      </div>
    </section>
  )}

</BaseLayout>
