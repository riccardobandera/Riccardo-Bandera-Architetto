---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Button from '../components/Button.astro';
import { fasi, fasiIntro, altreAttivita } from '../data/site';
import { seoPagina } from '../data/seo';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Le 6 fasi del progetto',
  description: fasiIntro,
  step: fasi.map((f, i) => ({ '@type': 'HowToStep', position: i + 1, name: f.title, text: f.body })),
};
---
<BaseLayout {...seoPagina('fasi')} jsonLd={jsonLd}>
  <section class="u-container pt-36 md:pt-44 pb-14">
    <p class="u-eyebrow mb-6 reveal">Metodo</p>
    <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(2.2rem,7vw,5.4rem)] max-w-[14ch] reveal">Le 6 fasi del progetto</h1>
    <p class="mt-8 max-w-2xl text-muted text-lg leading-relaxed reveal">{fasiIntro}</p>
  </section>

  <section class="u-container pb-[var(--spacing-section)]">
    <ProcessSteps />
  </section>

  <section class="bg-surface">
    <div class="u-container py-[var(--spacing-section)] grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="u-eyebrow mb-4 reveal">Oltre il progetto</p>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-extrabold tracking-tight leading-[1.02] reveal">Altre attività dello studio</h2>
        <p class="mt-6 text-muted leading-relaxed reveal">{altreAttivita.intro}</p>
      </div>
      <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-px bg-line border border-line">
        {altreAttivita.voci.map((v) => (
          <li class="bg-surface p-6 md:p-7 text-[1.02rem] font-medium leading-snug reveal">{v}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="u-container py-16 md:py-20 flex flex-wrap gap-4">
    <Button href="/contatti/" variant="solid" arrow>Iniziamo un progetto</Button>
    <Button href="/progetti/" variant="ghost">Guarda i lavori</Button>
  </section>
</BaseLayout>
