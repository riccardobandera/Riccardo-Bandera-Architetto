---
// Domande frequenti. Si pubblicano solo le domande con risposta (src/data/faq.json, dal CMS):
// le altre restano nascoste finché l'architetto non risponde.
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import Button from '../components/Button.astro';
import { seoPagina, faqPubblicate, faqAggiornato, faqLd, TEMI } from '../data/seo';
import { site } from '../data/site';

const gruppi = Object.entries(TEMI)
  .map(([k, label]) => ({ k, label, items: faqPubblicate.filter((f) => f.tema === k) }))
  .filter((g) => g.items.length);
const data = new Date(faqAggiornato).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = [
  faqLd(faqPubblicate),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Domande frequenti', item: new URL('/domande-frequenti/', site.url).href },
    ],
  },
];
---
<BaseLayout {...seoPagina('faq')} jsonLd={jsonLd}>
  <section class="u-container pt-36 md:pt-44 pb-12">
    <p class="u-eyebrow mb-6 reveal">Domande frequenti</p>
    <h1 class="font-sans font-extrabold uppercase tracking-[-0.02em] leading-[0.98] text-[clamp(2.2rem,7vw,5.4rem)] max-w-[16ch] reveal">Domande &amp; risposte</h1>
    <p class="mt-8 max-w-2xl text-muted text-lg leading-relaxed reveal">
      Le domande che ci fanno più spesso su progetto, pratiche, cantiere e costi, con le risposte dello studio {site.legalName} di {site.address.city}.
    </p>
    {gruppi.length > 1 && (
      <nav class="mt-10 flex flex-wrap gap-2.5 reveal" aria-label="Temi">
        {gruppi.map((g) => <a href={`#${g.k}`} class="inline-block border border-line rounded-full px-4 py-2 text-sm hover:bg-ink hover:text-bg transition-colors">{g.label}</a>)}
      </nav>
    )}
  </section>

  <section class="u-container pb-[var(--spacing-section)] space-y-16 md:space-y-20">
    {gruppi.map((g) => (
      <div id={g.k} class="grid lg:grid-cols-12 gap-6 lg:gap-10 scroll-mt-28">
        <h2 class="lg:col-span-4 text-[clamp(1.4rem,3vw,2rem)] font-extrabold tracking-tight leading-tight reveal">{g.label}</h2>
        <div class="lg:col-span-8"><FaqList items={g.items} /></div>
      </div>
    ))}
    <p class="text-sm text-muted">Aggiornato il {data}.</p>
  </section>

  <section class="bg-surface">
    <div class="u-container py-16 md:py-20 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <h2 class="text-[clamp(1.4rem,3.5vw,2.2rem)] font-bold tracking-tight max-w-xl">Non trovi la tua domanda? Scrivici.</h2>
      <Button href="/contatti/" variant="solid" arrow>Contattaci</Button>
    </div>
  </section>
</BaseLayout>
