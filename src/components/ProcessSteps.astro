---
import { Image } from 'astro:assets';
import { fasi } from '../data/site';
import { fasiImages } from '../data/curated';
import type { ImageMetadata } from 'astro';
// icone originali delle fasi (dal sito precedente)
const icone = import.meta.glob<{ default: ImageMetadata }>('../images/fasi/fase-*.png', { eager: true });
const icona = (n: string) => Object.entries(icone).find(([p]) => p.endsWith(`fase-${n}.png`))?.[1].default;
---
<div class="border-t border-line">
  {fasi.map((f) => {
    const imgs = fasiImages[f.n] ?? [];
    return (
      <article class="fase grid md:grid-cols-12 gap-6 md:gap-10 py-12 md:py-16 border-b border-line reveal">
        <div class="md:col-span-3 flex md:flex-col items-center md:items-start gap-5">
          <span class="font-display text-[3.2rem] md:text-[4.8rem] leading-none text-ink">{f.n}</span>
          {icona(f.n) && <Image src={icona(f.n)!} alt="" width={128} height={128} class="w-12 h-12 md:w-16 md:h-16 opacity-80" loading="lazy" />}
        </div>
        <div class="md:col-span-9">
          <h3 class="text-xl md:text-[1.7rem] font-bold tracking-tight mb-4 leading-tight">{f.title}</h3>
          <p class="text-muted leading-relaxed text-[1.02rem] max-w-3xl">{f.body}</p>
          {imgs.length > 0 && (
            <div class="fase-imgs mt-8 grid grid-cols-3 gap-2 md:gap-3">
              {imgs.map((im, i) => (
                <a href={`/progetti/${im.slug}/`} class="fase-img group relative block overflow-hidden bg-surface aspect-[4/3]" style={`--d:${i * 110}ms`} aria-label="Vedi il progetto">
                  <Image
                    src={im.src}
                    alt={`${f.title}: immagine dal progetto`}
                    widths={[360, 640]}
                    sizes="(max-width: 768px) 31vw, 22vw"
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.06]"
                  />
                </a>
              ))}
            </div>
          )}
        </div>
      </article>
    );
  })}
</div>

<style>
  /* le immagini compaiono una dopo l'altra quando la card entra in vista */
  :global(html.js) .fase-img { opacity: 0; transform: translateY(14px); transition: opacity 0.8s var(--ease-out-expo), transform 0.8s var(--ease-out-expo); transition-delay: var(--d); }
  :global(html.js) .fase.is-in .fase-img { opacity: 1; transform: none; }
</style>
