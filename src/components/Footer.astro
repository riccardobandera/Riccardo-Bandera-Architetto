---
import { Image } from 'astro:assets';
import { site, nav, manifestoQuote, homeTesti } from '../data/site';
import { servizi } from '../data/seo';
import monogram from '../images/monogram-white.png';
const year = new Date().getFullYear();
---

<footer class="bg-ink text-cream/70">
  <!-- CTA a tutta larghezza -->
  <a href="/contatti/" class="block group border-b border-white/12">
    <div class="u-container py-12 sm:py-16 md:py-24 flex flex-col md:flex-row md:items-end md:justify-between gap-6 sm:gap-8">
      <div>
        <p class="u-eyebrow text-cream/50 mb-3 sm:mb-4">Contatti</p>
        <h2 class="font-display text-cream text-[clamp(2.3rem,8vw,6.5rem)] leading-[0.95] tracking-tight">
          Start a project
        </h2>
      </div>
      <span class="btn btn--onDark shrink-0 group-hover:bg-bg group-hover:text-ink transition">
        Contattaci
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </span>
    </div>
  </a>

  <!-- telefono: Menu e Settori affiancati, social in riga, niente citazione (e gia in home): footer piu corto -->
  <div class="f-grid u-container py-10 sm:py-16 grid grid-cols-2 gap-x-6 gap-y-9 sm:gap-12 md:grid-cols-12">
    <!-- brand -->
    <div class="col-span-2 sm:col-span-1 md:col-span-3">
      <div class="f-head gap-3 text-cream">
        <Image src={monogram} alt="" width={38} height={40} class="w-[34px] h-auto" />
        <span class="flex flex-col leading-[1.05]">
          <span class="text-[0.82rem] font-bold tracking-[0.12em] uppercase">Riccardo Bandera</span>
          <span class="text-[0.6rem] tracking-[0.34em] uppercase text-cream/50">Architetto</span>
        </span>
      </div>
      <p class="text-sm max-w-xs">
        {homeTesti.footer}
      </p>
      <p class="f-gap text-sm text-cream/85 max-w-xs max-sm:hidden">{manifestoQuote}</p>
    </div>

    <!-- menu -->
    <nav class="md:col-span-2" aria-label="Footer">
      <p class="f-head u-eyebrow text-cream/40">Menu</p>
      <ul class="text-sm">
        {nav.map((i) => (
          <li><a href={i.href} class="u-underline text-cream/80 hover:text-cream">{i.label}</a></li>
        ))}
        <li><a href="/blog/" class="u-underline text-cream/80 hover:text-cream">Journal</a></li>
        <li><a href="/domande-frequenti/" class="u-underline text-cream/80 hover:text-cream">FAQ</a></li>
      </ul>
    </nav>

    <!-- settori -->
    <nav class="md:col-span-2" aria-label="Settori">
      <p class="f-head u-eyebrow text-cream/40">Settori</p>
      <ul class="text-sm">
        {servizi.map((s) => (
          <li><a href={`/${s.slug}/`} class="u-underline text-cream/80 hover:text-cream">{s.nome}</a></li>
        ))}
      </ul>
    </nav>

    <!-- contatti -->
    <div class="col-span-2 sm:col-span-1 md:col-span-3">
      <p class="f-head u-eyebrow text-cream/40">Studio</p>
      <address class="not-italic text-sm">
        <p>{site.address.street}<br />{site.address.zip} {site.address.city}, {site.address.region}</p>
        <p class="f-gap">
          <a href={`mailto:${site.email}`} class="u-underline block w-fit">{site.email}</a>
          <a href={`tel:${site.phoneHref}`} class="u-underline block w-fit">Tel. {site.phone}</a>
          <a href={`mailto:${site.pec}`} class="u-underline block w-fit">PEC {site.pec}</a>
        </p>
      </address>
    </div>

    <!-- social -->
    <div class="col-span-2 sm:col-span-1 md:col-span-2">
      <p class="f-head u-eyebrow text-cream/40">Social</p>
      <ul class="text-sm flex flex-wrap gap-x-6 sm:block">
        <li><a href={site.social.instagram} target="_blank" rel="noopener" class="u-underline">Instagram</a></li>
        <li><a href={site.social.facebook} target="_blank" rel="noopener" class="u-underline">Facebook</a></li>
        <li><a href={site.social.linkedin} target="_blank" rel="noopener" class="u-underline">LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="u-container py-5 sm:py-6 border-t border-white/10 flex flex-col sm:flex-row gap-2.5 sm:gap-3 sm:items-center sm:justify-between text-xs text-cream/45">
    <p>© {year} {site.legalName} · P.IVA {site.piva} · {site.ordine}</p>
    <div class="flex gap-5">
      <a href="/privacy/" class="u-underline">Privacy</a>
      <a href="/cookie/" class="u-underline">Cookie</a>
      <button type="button" class="u-underline" data-cookie-prefs>Preferenze cookie</button>
    </div>
  </div>
</footer>

<style>
  /* testata di ogni colonna (logo o etichetta) alta uguale: i testi sotto partono tutti alla stessa riga */
  .f-head { height: 2.5rem; margin-bottom: 1.25rem; display: flex; align-items: flex-end; }
  /* tutte le righe di testo sullo stesso passo (23px): le righe delle colonne si allineano in orizzontale.
     Gli stacchi (citazione, contatti) valgono esattamente una riga, così la griglia non si sfasa */
  .f-grid { --fl: 1.4375rem; }
  .f-grid p:not(.f-head), .f-grid li, .f-grid address a { line-height: var(--fl); }
  .f-grid .f-gap { margin-top: var(--fl); }
  /* telefono: etichette compatte (l'allineamento tra colonne serve solo da tablet in su) */
  @media (max-width: 639px) {
    .f-head { height: auto; margin-bottom: 0.7rem; }
    .f-grid .f-gap { margin-top: 0.6rem; }
  }
</style>
