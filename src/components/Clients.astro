---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// loghi reali dei clienti (dalla home del sito precedente)
const files = import.meta.glob<{ default: ImageMetadata }>('../images/clienti/*.webp', { eager: true });
const NOMI: Record<string, string> = {
  'amani-boutique-hotel': 'Amani Boutique Hotel',
  'brentonicoski': 'Brentonicoski',
  'ca-sabbionare': 'Ca’ Sabbionare',
  'chalet-pinocchio': 'Chalet Pinocchio',
  'forno-brisa': 'Forno Brisa',
  'funivia-malcesine-monte-baldo': 'Funivia Malcesine Monte Baldo',
  'hotel-antares': 'Hotel Antares',
  'kono-kono-zanzibar': 'Kono Kono Zanzibar',
  'manica': 'Manica',
  'panificio-moderno': 'Panificio Moderno',
};
const loghi = Object.entries(files).map(([p, m]) => {
  const key = p.split('/').pop()!.replace('.webp', '');
  return { src: m.default, nome: NOMI[key] ?? key };
});
---
<section class="py-16 md:py-20 border-y border-line" aria-labelledby="clienti-title">
  <div class="u-container mb-10 flex items-end justify-between gap-6">
    <h2 id="clienti-title" class="u-eyebrow">Hanno scelto lo studio</h2>
  </div>
  <div class="marquee overflow-hidden" aria-label="Loghi dei clienti">
    <ul class="marquee-track items-center gap-16 md:gap-24 pr-16 md:pr-24">
      {[...loghi, ...loghi].map((l, i) => (
        <li class="shrink-0" aria-hidden={i >= loghi.length ? 'true' : undefined}>
          <Image src={l.src} alt={i >= loghi.length ? '' : `Logo ${l.nome}`} height={92} class="h-[3.45rem] md:h-[4.6rem] w-auto opacity-70 hover:opacity-100 transition-opacity duration-500" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // la fascia scorre da sola; col dito (o trascinando col mouse) si sposta avanti e indietro,
  // e quando la si lascia riprende a scorrere da dove è rimasta
  document.querySelectorAll<HTMLElement>('.marquee').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.marquee-track');
    if (!track || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    box.classList.add('is-js');
    const SPEED = 40; // pixel al secondo
    let x = 0, last = performance.now(), dragging = false, startX = 0, startOff = 0, hover = false, resumeAt = 0;
    const half = () => track.scrollWidth / 2;
    const wrap = () => { const h = half(); if (h > 0) { while (x <= -h) x += h; while (x > 0) x -= h; } };
    const tick = (t: number) => {
      const dt = Math.min(0.05, (t - last) / 1000); last = t;
      if (!dragging && !hover && t >= resumeAt) x -= SPEED * dt;
      wrap();
      track.style.transform = `translate3d(${x}px,0,0)`;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    box.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    box.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') hover = false; });
    box.addEventListener('pointerdown', (e) => { dragging = true; startX = e.clientX; startOff = x; box.setPointerCapture?.(e.pointerId); });
    box.addEventListener('pointermove', (e) => { if (dragging) { x = startOff + (e.clientX - startX); wrap(); } });
    const end = () => { if (dragging) { dragging = false; resumeAt = performance.now() + 1200; } };
    box.addEventListener('pointerup', end);
    box.addEventListener('pointercancel', end);
    box.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>

<style>
  /* con lo script attivo l'animazione la guida lo script (così si può trascinare) */
  .marquee.is-js { touch-action: pan-y; cursor: grab; user-select: none; }
  .marquee.is-js :global(.marquee-track) { animation: none; }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
  }
</style>
