---
import { categories, projectCount } from '../data/projects';
---
<div class="filter flex flex-wrap items-center gap-2.5" role="tablist" aria-label="Filtra progetti per ambito">
  <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
    Tutti <span class="text-muted/70">{projectCount}</span>
  </button>
  {categories.map((c) => (
    <button class="filter-btn" data-filter={c.key} role="tab" aria-selected="false">
      {c.label} <span class="text-muted/70">{c.count}</span>
    </button>
  ))}
</div>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  const apply = (f: string) => {
    cards.forEach((card) => {
      const cats = (card.dataset.cats || '').split(' ');
      const show = f === 'all' || cats.includes(f);
      card.style.display = show ? '' : 'none';
    });
    buttons.forEach((b) => {
      const on = b.dataset.filter === f;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', String(on));
    });
    history.replaceState(null, '', f === 'all' ? location.pathname : `#${f}`);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  const hash = location.hash.replace('#', '');
  if (hash && buttons.some((b) => b.dataset.filter === hash)) apply(hash);
</script>

<style>
  .filter-btn {
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: all 0.35s var(--ease-out-expo);
  }
  .filter-btn:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .filter-btn.is-active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }
  .filter-btn.is-active .text-muted\/70 { color: rgba(255,255,255,0.6); }
</style>
