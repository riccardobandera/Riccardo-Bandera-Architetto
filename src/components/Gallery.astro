---
import { Image } from 'astro:assets';
import type { ProjectImage } from '../data/projects';

interface Props {
  images: ProjectImage[];
  id?: string;
}
const { images, id = 'gallery' } = Astro.props;
// pattern editoriale: alterna full-width e coppie
const layoutFor = (i: number): string => {
  const m = i % 5;
  if (m === 0) return 'md:col-span-12'; // wide
  if (m === 1 || m === 2) return 'md:col-span-6'; // pair
  if (m === 3) return 'md:col-span-7';
  return 'md:col-span-5';
};
---
<div id={id} class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4" data-gallery>
  {images.map((im, i) => (
    <figure class={`relative overflow-hidden bg-surface ${layoutFor(i)} reveal`}>
      <button
        type="button"
        class="group block w-full cursor-zoom-in"
        data-lightbox
        data-index={i}
        aria-label={`Ingrandisci: ${im.alt}`}
      >
        <Image
          src={im.image}
          alt={im.alt}
          widths={[480, 768, 1200, 1800]}
          sizes="(max-width: 768px) 92vw, 80vw"
          loading={i < 2 ? 'eager' : 'lazy'}
          class="w-full h-auto object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
        />
      </button>
    </figure>
  ))}
</div>

<!-- Lightbox -->
<div id={`${id}-lb`} class="lightbox fixed inset-0 z-[90] bg-ink/96 backdrop-blur-sm hidden opacity-0 transition-opacity duration-400" role="dialog" aria-modal="true" aria-label="Galleria immagini">
  <button class="lb-close absolute top-5 right-5 z-10 grid place-items-center w-12 h-12 text-cream/80 hover:text-cream" aria-label="Chiudi">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="lb-prev absolute left-3 md:left-6 top-1/2 -translate-y-1/2 z-10 grid place-items-center w-12 h-12 text-cream/70 hover:text-cream" aria-label="Precedente">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <button class="lb-next absolute right-3 md:right-6 top-1/2 -translate-y-1/2 z-10 grid place-items-center w-12 h-12 text-cream/70 hover:text-cream" aria-label="Successiva">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 6l6 6-6 6"/></svg>
  </button>
  <div class="lb-stage absolute inset-0 flex items-center justify-center p-5 md:p-16 select-none">
    <img class="lb-img max-w-full max-h-full object-contain" alt="" />
  </div>
  <div class="lb-counter absolute bottom-5 left-1/2 -translate-x-1/2 text-cream/60 text-xs tracking-[0.2em]"></div>
</div>

<script is:inline define:vars={{ id, sources: images.map((im) => ({ src: im.image.src, alt: im.alt })) }}>
  (() => {
    const root = document.getElementById(id);
    const lb = document.getElementById(id + '-lb');
    if (!root || !lb) return;
    const imgEl = lb.querySelector('.lb-img');
    const counter = lb.querySelector('.lb-counter');
    let cur = 0;

    const render = () => {
      const s = sources[cur];
      imgEl.src = s.src;
      imgEl.alt = s.alt;
      counter.textContent = `${String(cur + 1).padStart(2, '0')} / ${String(sources.length).padStart(2, '0')}`;
    };
    const open = (i) => {
      cur = i; render();
      lb.classList.remove('hidden');
      requestAnimationFrame(() => lb.classList.remove('opacity-0'));
      document.documentElement.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.add('opacity-0');
      document.documentElement.style.overflow = '';
      setTimeout(() => lb.classList.add('hidden'), 350);
    };
    const go = (d) => { cur = (cur + d + sources.length) % sources.length; render(); };

    root.querySelectorAll('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => open(parseInt(b.getAttribute('data-index')))));
    lb.querySelector('.lb-close').addEventListener('click', close);
    lb.querySelector('.lb-prev').addEventListener('click', () => go(-1));
    lb.querySelector('.lb-next').addEventListener('click', () => go(1));
    lb.addEventListener('click', (e) => { if (e.target === lb || e.target.classList.contains('lb-stage')) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });
    // swipe mobile
    let x0 = null;
    lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 45) go(dx < 0 ? 1 : -1);
      x0 = null;
    }, { passive: true });
  })();
</script>
