---
import { Image } from 'astro:assets';
import type { Immagine } from '../data/projects';

interface Props {
  images: Immagine[];
  id?: string;
  /** disegni: griglia regolare, nessun ritaglio, fondo bianco */
  variant?: 'foto' | 'disegni';
  eagerFirst?: boolean;
}
const { images, id = 'gallery', variant = 'foto', eagerFirst = false } = Astro.props;
// galleria "giustificata": in ogni riga le foto hanno la stessa altezza e la larghezza segue le loro
// proporzioni, quindi riempiono la riga senza vuoti di colore e senza ritagliare nulla
const ratio = (im: Immagine) => (im.src.width && im.src.height ? im.src.width / im.src.height : 1.5);
---
<div id={id} class:list={['jg', variant === 'disegni' && 'jg--disegni']} data-gallery>
  {images.map((im, i) => (
    <figure class:list={['jg-item relative overflow-hidden reveal', variant === 'disegni' ? 'bg-bg border border-line' : '']} style={`--r:${ratio(im).toFixed(4)}`}>
      <button
        type="button"
        class="group block w-full h-full cursor-zoom-in"
        data-lightbox
        data-full={im.src.src}
        data-alt={im.alt ?? ''}
        aria-label={`Ingrandisci: ${im.alt ?? ''}`}
      >
        <Image
          src={im.src}
          alt={im.alt ?? ''}
          widths={[640, 1200, 1800]}
          sizes="(max-width: 768px) 92vw, 60vw"
          loading={eagerFirst && i < 1 ? 'eager' : 'lazy'}
          class:list={['w-full h-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]', variant === 'disegni' ? 'object-contain p-3 md:p-5' : 'object-cover']}
        />
      </button>
      {im.etichetta && <span class="jg-tag">{im.etichetta}</span>}
    </figure>
  ))}
</div>
<!-- lightbox con zoom: globale, in src/scripts/lightbox.ts (funziona anche nella finestra di /progetti) -->
