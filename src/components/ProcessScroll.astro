---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { metodoImages as M, metodoProgetto } from '../data/curated';
import { getProgetto, coverOf } from '../data/projects';
// dettaglio costruttivo ritagliato dalla tavola esecutiva della casera (la parte scelta dal cliente)
import dettaglio from '../images/metodo/dettaglio-esecutivo.webp';

// il progetto raccontato: dalla pianta all'opera finita
const progetto = await getProgetto(metodoProgetto);
const nomeProgetto = progetto?.data.titolo ?? '';
// foto d'apertura scelta dal cliente: la Cantina Vini Colombo
const cantina = await getProgetto('csa-cantina-vini-colombo-sul-lago-di-garda-vr');
const cantinaCover = cantina ? coverOf(cantina) : null;

const curve = `<svg viewBox="0 0 120 60" fill="none" class="ms-curve"><path d="M2 42 C 30 4, 90 4, 118 42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;

// media sotto le scritte: foto vera, oppure riquadro vuoto in attesa delle foto del cliente
type Media =
  | { kind: 'img'; src: ImageMetadata; alt: string; cap: string; drawing?: boolean; href?: string }
  | { kind: 'empty' }
  | { kind: 'fade' };
type Tok =
  | { kind: 'lead'; t: string; media?: Media }
  | { kind: 'text'; t: string }
  | { kind: 'phase'; n: string; t: string; media?: Media }
  | { kind: 'svg' };

const flow: Tok[] = [
  {
    kind: 'lead', t: 'Ogni progetto',
    media: cantinaCover ? { kind: 'img', src: cantinaCover.src, alt: cantinaCover.alt, cap: 'Cantina Vini Colombo, lago di Garda', href: `/progetti/${cantina!.id}/` } : undefined,
  },
  { kind: 'text', t: 'nasce dal disegno,' },
  { kind: 'phase', n: '01', t: 'Progetto architettonico e di interni', media: { kind: 'empty' } }, // render 3D in arrivo
  { kind: 'text', t: 'ottiene i permessi col' },
  { kind: 'phase', n: '02', t: 'Progetto amministrativo', media: { kind: 'empty' } },
  { kind: 'text', t: 'si fa dettaglio nel' },
  { kind: 'phase', n: '03', t: 'Progetto esecutivo', media: { kind: 'img', src: dettaglio, alt: `${nomeProgetto}: dettaglio costruttivo`, cap: 'Dettaglio costruttivo', drawing: true } },
  { kind: 'text', t: 'trova il suo costo nella' },
  { kind: 'phase', n: '04', t: 'Preventivazione', media: { kind: 'fade' } }, // preventivi del cliente in arrivo
  { kind: 'svg' },
  { kind: 'text', t: 'si costruisce durante la' },
  { kind: 'phase', n: '05', t: 'Direzione lavori', media: M['05'] ? { kind: 'img', src: M['05'], alt: `${nomeProgetto}: cantiere`, cap: 'Cantiere' } : undefined },
  { kind: 'text', t: 'e diventa realtà con la' },
  { kind: 'phase', n: '06', t: 'Fine lavori.', media: M['06'] ? { kind: 'img', src: M['06'], alt: `${nomeProgetto}: opera finita`, cap: 'Opera finita' } : undefined },
];
const fasiNum = flow.filter((t) => t.kind === 'phase').map((t) => (t as { n: string }).n);
---

<section class="method-scroll relative bg-bg text-ink -mt-[20svh] lg:-mt-[14svh]" data-method-scroll aria-label="Le 6 fasi del progetto">
  <div class="ms-pin h-[100svh] flex items-start overflow-x-auto overflow-y-hidden [scrollbar-width:none]" data-pin>
    <div class="ms-track relative flex items-start gap-[4vw] md:gap-[5vw] pl-[8vw] pr-[10vw] will-change-transform" data-track>

      <div class="ms-mid shrink-0 pr-[3vw] max-w-[36rem]">
        <p class="u-eyebrow mb-4">Metodo</p>
        <h2 class="font-sans font-extrabold uppercase leading-[0.88] tracking-[-0.02em] text-[clamp(2.6rem,8vw,7rem)]">Le 6 fasi<br />del progetto</h2>
        {nomeProgetto && <p class="mt-6 text-base md:text-lg text-muted leading-relaxed whitespace-normal">Un progetto vero, dal disegno all'opera finita:<br /><a href={`/progetti/${metodoProgetto}/`} class="u-underline text-ink">{nomeProgetto}</a>.</p>}
      </div>

      {flow.map((it) => (
        it.kind === 'text' ? (
          <span class="ms-muted ms-conn shrink-0 whitespace-nowrap">{it.t}</span>
        ) : it.kind === 'svg' ? (
          <span class="ms-svgwrap ms-conn shrink-0 text-ink/70" set:html={curve}></span>
        ) : (
          <div class="shrink-0 flex flex-col items-end" data-phase={it.kind === 'phase' ? it.n : undefined}>
            {it.kind === 'lead' ? (
              <span class="ms-lead ms-lead-pos whitespace-nowrap">{it.t}</span>
            ) : (
              <span class="flex flex-col leading-none">
                <span class="ms-num font-display text-muted/45">{it.n}</span>
                <span class="font-sans font-extrabold uppercase tracking-tight text-[clamp(1rem,2.2vw,1.9rem)] mt-2 whitespace-nowrap">{it.t}</span>
              </span>
            )}
            {it.media && (
              <figure class:list={['ms-media flex flex-col items-end', it.kind === 'lead' ? 'ms-media-lead' : 'ms-media-phase']}>
                {it.media.kind === 'img' ? (
                  <>
                    <span class:list={['ms-shot block w-fit overflow-hidden', it.media.drawing ? 'bg-bg border border-line p-2 md:p-3' : 'bg-surface']}>
                      <Image src={it.media.src} alt={it.media.alt} widths={[500, 800, 1100]} sizes="50vw" class:list={['h-full w-auto max-w-none', it.media.drawing ? 'object-contain' : 'object-cover']} />
                    </span>
                    <figcaption class="mt-2 text-right text-[0.8rem] md:text-[0.86rem] uppercase tracking-[0.16em] text-muted">
                      {it.media.href ? <a href={it.media.href} class="u-underline hover:text-ink">{it.media.cap}</a> : it.media.cap}
                    </figcaption>
                  </>
                ) : it.media.kind === 'empty' ? (
                  <span class="ms-shot ms-empty block" aria-hidden="true"></span>
                ) : (
                  <span class="ms-shot ms-fade block" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
                )}
              </figure>
            )}
          </div>
        )
      ))}

      <div class="ms-mid shrink-0">
        <a href="/fasi-del-progetto/" class="inline-flex items-center gap-3 whitespace-nowrap font-sans font-extrabold uppercase tracking-tight text-[clamp(1.4rem,3vw,2.6rem)] group">
          Come lavoriamo
          <span class="grid place-items-center w-14 h-14 md:w-16 md:h-16 rounded-full border border-ink group-hover:bg-ink group-hover:text-bg transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </a>
      </div>

    </div>
  </div>

  <!-- avanzamento: la linea cresce o cala con lo scorrimento, i 6 punti sono le fasi -->
  <div class="ms-progress absolute bottom-5 left-[8vw] right-[8vw] h-px bg-line">
    <span class="block h-full bg-ink w-0" data-progress></span>
    {fasiNum.map((n, i) => (
      <button type="button" class="ms-mark" data-mark={n} style={`left:${(i / (fasiNum.length - 1)) * 100}%`} aria-label={`Vai alla fase ${n}`}>
        <span class="ms-mark-n">{n}</span>
        <span class="ms-dot"></span>
      </button>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const setup = () => {
    const section = document.querySelector<HTMLElement>('[data-method-scroll]');
    const track = document.querySelector<HTMLElement>('[data-track]');
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const pinWrap = section?.querySelector<HTMLElement>('[data-pin]');
    if (!section || !track || !pinWrap) return;
    const marks = Array.from(section.querySelectorAll<HTMLElement>('[data-mark]'));
    const phases = marks.map((m) => track.querySelector<HTMLElement>(`[data-phase="${m.dataset.mark}"]`));

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth < 1024;
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);

    // a che punto dello scorrimento ogni fase arriva a un terzo dello schermo
    let at: number[] = [];
    const measure = () => {
      const d = distance() || 1;
      at = phases.map((el) => (el ? Math.min(1, Math.max(0, (el.offsetLeft - window.innerWidth * 0.33) / d)) : 0));
      marks.forEach((m, i) => (m.style.left = `${(at[i] * 100).toFixed(2)}%`));
    };
    const paint = (p: number) => {
      if (bar) bar.style.width = (p * 100).toFixed(2) + '%';
      marks.forEach((m, i) => m.classList.toggle('is-on', p >= at[i] - 0.002));
    };
    measure();
    paint(0);
    window.addEventListener('resize', () => { measure(); });

    // mobile o movimento ridotto: scorrimento orizzontale nativo, la linea segue lo scroll del contenitore
    if (reduce || isMobile || distance() <= 0) {
      const onScroll = () => {
        const max = pinWrap.scrollWidth - pinWrap.clientWidth || 1;
        paint(pinWrap.scrollLeft / max);
      };
      pinWrap.addEventListener('scroll', onScroll, { passive: true });
      marks.forEach((m, i) => m.addEventListener('click', () => {
        pinWrap.scrollTo({ left: at[i] * (pinWrap.scrollWidth - pinWrap.clientWidth), behavior: reduce ? 'auto' : 'smooth' });
      }));
      return;
    }

    pinWrap.style.overflowX = 'hidden';
    const tween = gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => '+=' + distance(),
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onRefresh: measure,
        onUpdate: (self) => paint(self.progress),
      },
    });
    // clic su una fase: lo scroll della pagina porta a quel punto della sequenza
    marks.forEach((m, i) => m.addEventListener('click', () => {
      const st = tween.scrollTrigger;
      if (st) window.scrollTo({ top: st.start + at[i] * (st.end - st.start), behavior: 'smooth' });
    }));
  };

  if (document.readyState === 'complete') setup();
  else window.addEventListener('load', setup);
</script>

<style>
  .method-scroll {
    isolation: isolate;
    --num: min(clamp(3.5rem, 9vw, 8rem), 13svh);  /* numero della fase */
    --conn: clamp(1.3rem, 3.2vw, 3rem);          /* frasi di collegamento */
    --lead: clamp(2rem, 5.5vw, 5rem);            /* "Ogni progetto" */
    --mid: 44svh;                                /* altezza della riga delle scritte */
    --shot: clamp(187px, 27.5svh, 363px);        /* altezza foto e riquadri */
  }
  /* tutte le scritte stanno sulla stessa riga, a metà schermo; foto e riquadri pendono sotto */
  .ms-track { margin-top: calc(var(--mid) - var(--num) / 2); }
  .ms-num { font-size: var(--num); line-height: 1; }
  .ms-lead { font-family: var(--font-sans); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; font-size: var(--lead); line-height: 0.9; }
  .ms-muted { font-family: var(--font-display); font-style: italic; color: var(--color-muted); font-size: var(--conn); line-height: 1; }
  .ms-conn { margin-top: calc(var(--num) / 2 - var(--conn) / 2); }
  .ms-lead-pos { margin-top: calc(var(--num) / 2 - var(--lead) * 0.45); }
  .ms-svgwrap { margin-top: calc(var(--num) / 2 - clamp(20px, 2.6vw, 40px)); }
  .ms-svgwrap :global(.ms-curve) { width: clamp(70px, 9vw, 140px); height: auto; }
  /* blocco d'apertura e link finale centrati sulla stessa riga */
  .ms-mid { margin-top: calc(var(--num) / 2); transform: translateY(-50%); }

  /* foto sotto le scritte: tutte alte uguali, allineate a destra con l'ultima lettera della scritta sopra */
  .ms-shot { height: var(--shot); }
  .ms-media-lead, .ms-media-phase { margin-top: clamp(1.25rem, 2.6svh, 2rem); }
  .ms-empty, .ms-fade { aspect-ratio: 4 / 3; background: var(--color-surface); border: 1px solid var(--color-line); }
  /* riquadro per i preventivi: righe di documento che sfumano verso il basso */
  .ms-fade {
    display: flex; flex-direction: column; gap: 9%; padding: 12% 10%;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
  .ms-fade span { display: block; height: 2px; background: color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .ms-fade span:nth-child(2) { width: 82%; }
  .ms-fade span:nth-child(3) { width: 90%; }
  .ms-fade span:nth-child(4) { width: 64%; }
  .ms-fade span:nth-child(5) { width: 76%; }

  .ms-pin::-webkit-scrollbar { display: none; }

  /* indicatore delle 6 fasi sulla linea di avanzamento */
  .ms-mark {
    position: absolute; top: 0; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; cursor: pointer; background: none; border: 0; padding: 0;
  }
  .ms-dot { width: 9px; height: 9px; border-radius: 9999px; background: var(--color-bg); border: 1.5px solid color-mix(in srgb, var(--color-ink) 35%, transparent); transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease; }
  .ms-mark-n { position: absolute; bottom: 100%; margin-bottom: 0; font-size: 0.82rem; letter-spacing: 0.12em; color: var(--color-muted); transition: color 0.3s ease; }
  .ms-mark.is-on .ms-dot { background: var(--color-ink); border-color: var(--color-ink); transform: scale(1.15); }
  .ms-mark.is-on .ms-mark-n { color: var(--color-ink); }
  .ms-mark:hover .ms-dot { border-color: var(--color-ink); }
  .ms-mark:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; border-radius: 9999px; }
</style>
