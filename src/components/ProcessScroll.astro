---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { metodoImages as M, metodoExtra as X, metodoProgetto } from '../data/curated';
import { getProgetto } from '../data/projects';

// il progetto raccontato: dalla pianta all'opera finita
const progetto = await getProgetto(metodoProgetto);
const nomeProgetto = progetto?.data.titolo ?? '';

const curve = `<svg viewBox="0 0 120 60" fill="none" class="ms-curve"><path d="M2 42 C 30 4, 90 4, 118 42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;

type Tok =
  | { kind: 'text'; t: string; cls: string }
  | { kind: 'phase'; n: string; t: string }
  | { kind: 'img'; src: ImageMetadata; alt: string; cap: string; h: string; drawing?: boolean }
  | { kind: 'svg' };
const text = (t: string, cls = 'ms-muted'): Tok => ({ kind: 'text', t, cls });
const phase = (n: string, t: string): Tok => ({ kind: 'phase', n, t });
const img = (src: ImageMetadata, cap: string, h: string, drawing = false): Tok => ({ kind: 'img', src, cap, h, drawing, alt: `${nomeProgetto}: ${cap.toLowerCase()}` });

const flow: Tok[] = [
  text('Ogni progetto', 'ms-lead'),
  img(M['01'], 'Pianta', 'h-[40vh] md:h-[46vh]', true),
  text('nasce su carta,'),
  phase('01', 'Progetto architettonico e di interni'),
  img(X['01'], 'Modello 3D', 'h-[38vh] md:h-[44vh]'),
  text('ottiene i permessi col'),
  phase('02', 'Progetto amministrativo'),
  img(M['02'], 'Sezione', 'h-[42vh] md:h-[48vh]', true),
  text('si fa dettaglio nel'),
  phase('03', 'Progetto esecutivo'),
  img(M['03'], 'Dettaglio costruttivo', 'h-[42vh] md:h-[48vh]', true),
  text('trova il suo costo nella'),
  phase('04', 'Preventivazione'),
  img(M['04'], 'Prima dei lavori', 'h-[38vh] md:h-[44vh]'),
  { kind: 'svg' },
  text('si costruisce con la'),
  phase('05', 'Direzione lavori'),
  img(M['05'], 'Cantiere', 'h-[40vh] md:h-[46vh]'),
  img(X['05'], 'Cantiere, interni', 'h-[44vh] md:h-[50vh]'),
  text('e diventa realtà con la'),
  phase('06', 'Fine lavori.'),
  img(M['06'], 'Opera finita', 'h-[46vh] md:h-[54vh]'),
  img(X['06'], 'Opera finita', 'h-[40vh] md:h-[46vh]'),
].filter((t) => t.kind !== 'img' || (t as { src?: unknown }).src);
---

<section class="method-scroll relative bg-bg text-ink -mt-[20svh] lg:-mt-[14svh]" data-method-scroll aria-label="Le 6 fasi del progetto">
  <div class="ms-pin h-[100svh] flex items-center overflow-x-auto overflow-y-hidden [scrollbar-width:none]" data-pin>
    <div class="ms-track flex items-center gap-[4vw] md:gap-[5vw] pl-[8vw] pr-[10vw] will-change-transform" data-track>

      <div class="shrink-0 pr-[3vw] max-w-[36rem]">
        <p class="u-eyebrow mb-4">Metodo</p>
        <h2 class="font-sans font-extrabold uppercase leading-[0.88] tracking-[-0.02em] text-[clamp(2.6rem,8vw,7rem)]">Le 6 fasi<br />del progetto</h2>
        {nomeProgetto && <p class="mt-6 text-sm text-muted leading-relaxed whitespace-normal">Un progetto vero, dal disegno all'opera finita:<br /><a href={`/progetti/${metodoProgetto}/`} class="u-underline text-ink">{nomeProgetto}</a>.</p>}
      </div>

      {flow.map((it) => (
        it.kind === 'text' ? (
          <span class:list={['shrink-0 whitespace-nowrap', it.cls]}>{it.t}</span>
        ) : it.kind === 'phase' ? (
          <span class="ms-phase shrink-0 flex flex-col leading-none">
            <span class="font-display text-[clamp(3.5rem,11vw,9rem)] text-muted/45">{it.n}</span>
            <span class="font-sans font-extrabold uppercase tracking-tight text-[clamp(1rem,2.2vw,1.9rem)] mt-2 whitespace-nowrap">{it.t}</span>
          </span>
        ) : it.kind === 'img' ? (
          <figure class="shrink-0 flex flex-col">
            <span class:list={['ms-shot block overflow-hidden', it.h, it.drawing ? 'bg-bg border border-line p-2 md:p-3' : 'bg-surface']}>
              <Image src={it.src} alt={it.alt} widths={[500, 800, 1100]} sizes="60vw" class:list={['h-full w-auto max-w-none', it.drawing ? 'object-contain' : 'object-cover']} />
            </span>
            <figcaption class="mt-3 text-[0.68rem] uppercase tracking-[0.18em] text-muted">{it.cap}</figcaption>
          </figure>
        ) : (
          <span class="ms-svgwrap shrink-0 text-ink/70" set:html={curve}></span>
        )
      ))}

      <div class="shrink-0 flex flex-col gap-5">
        <a href="/fasi-del-progetto/" class="inline-flex items-center gap-3 whitespace-nowrap font-sans font-extrabold uppercase tracking-tight text-[clamp(1.4rem,3vw,2.6rem)] group">
          Come lavoriamo
          <span class="grid place-items-center w-14 h-14 md:w-16 md:h-16 rounded-full border border-ink group-hover:bg-ink group-hover:text-bg transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </a>
        <a href={`/progetti/${metodoProgetto}/`} class="u-underline w-fit text-sm text-muted hover:text-ink">Guarda il progetto completo</a>
      </div>

    </div>
  </div>

  <div class="ms-progress absolute bottom-6 left-[8vw] right-[8vw] h-px bg-line">
    <span class="block h-full bg-ink w-0" data-progress></span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const setup = () => {
    const section = document.querySelector<HTMLElement>('[data-method-scroll]');
    const track = document.querySelector<HTMLElement>('[data-track]');
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    if (!section || !track) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth < 1024;
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
    const pinWrap = section.querySelector<HTMLElement>('[data-pin]');
    if (reduce || isMobile || distance() <= 0) return; // mobile: swipe nativo, nessun pin
    if (pinWrap) pinWrap.style.overflowX = 'hidden';

    gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => '+=' + distance(),
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => { if (bar) bar.style.width = (self.progress * 100).toFixed(2) + '%'; },
      },
    });
  };

  if (document.readyState === 'complete') setup();
  else window.addEventListener('load', setup);
</script>

<style>
  .ms-lead { font-family: var(--font-sans); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; font-size: clamp(2rem, 5.5vw, 5rem); line-height: 0.9; }
  .ms-muted { font-family: var(--font-display); font-style: italic; color: var(--color-muted); font-size: clamp(1.3rem, 3.2vw, 3rem); line-height: 1; }
  .ms-svgwrap :global(.ms-curve) { width: clamp(70px, 9vw, 140px); height: auto; }
  .ms-pin::-webkit-scrollbar { display: none; }
  .method-scroll { isolation: isolate; }
</style>
