---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { metodoImages as M, metodoProgetto } from '../data/curated';
import { getProgetto } from '../data/projects';
import { homeTesti } from '../data/site';
const T = homeTesti.metodo;
// immagini della casera nell'Alpago in ordine cronologico (cartella "Metodo" di Riccardo, ottobre 2026)
import modello3d from '../images/metodo/casera-modello-3d.webp';
import prospetti from '../images/metodo/casera-prospetti-progetto-amministrativo.webp';
// dettaglio costruttivo ritagliato dalla tavola esecutiva della casera (la parte scelta dal cliente)
import dettaglio from '../images/metodo/dettaglio-esecutivo.webp';
// preventivazione: la tavola riassuntiva del quadro budget (stessa della pagina Fasi)
import quadroBudget from '../images/fasi/04/fase-04-quadro-economico-02.webp';
import ponteggi from '../images/metodo/casera-cantiere-ponteggi.webp';

// il progetto raccontato: dalla pianta all'opera finita
const progetto = await getProgetto(metodoProgetto);
const nomeProgetto = progetto?.data.titolo ?? '';


// media sotto le scritte: foto vera, oppure riquadro vuoto in attesa delle foto del cliente
type Media =
  | { kind: 'img'; src: ImageMetadata; alt: string; cap: string; drawing?: boolean; href?: string }
  | { kind: 'empty' }
  | { kind: 'fade' };
type Tok =
  | { kind: 'text'; t: string }
  | { kind: 'phase'; n: string; t: string; media?: Media };

const flow: Tok[] = [
  { kind: 'text', t: T.passi[0].frase },
  { kind: 'phase', n: '01', t: T.passi[0].fase, media: { kind: 'img', src: modello3d, alt: `${nomeProgetto}: modello 3D di progetto`, cap: T.passi[0].didascalia } },
  { kind: 'text', t: T.passi[1].frase },
  { kind: 'phase', n: '02', t: T.passi[1].fase, media: { kind: 'img', src: prospetti, alt: `${nomeProgetto}: prospetti della tavola di progetto per il Comune`, cap: T.passi[1].didascalia, drawing: true } },
  { kind: 'text', t: T.passi[2].frase },
  { kind: 'phase', n: '03', t: T.passi[2].fase, media: { kind: 'img', src: dettaglio, alt: `${nomeProgetto}: dettaglio costruttivo`, cap: T.passi[2].didascalia, drawing: true } },
  { kind: 'text', t: T.passi[3].frase },
  { kind: 'phase', n: '04', t: T.passi[3].fase, media: { kind: 'img', src: quadroBudget, alt: 'Quadro budget riassuntivo di un progetto dello studio: minimo, massimo e scelte consigliate', cap: T.passi[3].didascalia, drawing: true } },
  { kind: 'text', t: T.passi[4].frase },
  { kind: 'phase', n: '05', t: T.passi[4].fase, media: { kind: 'img', src: ponteggi, alt: `${nomeProgetto}: cantiere con i ponteggi`, cap: T.passi[4].didascalia } },
  { kind: 'text', t: T.passi[5].frase },
  { kind: 'phase', n: '06', t: T.passi[5].fase, media: M['06'] ? { kind: 'img', src: M['06'], alt: `${nomeProgetto}: opera finita`, cap: T.passi[5].didascalia } : undefined },
];
const fasiNum = flow.filter((t) => t.kind === 'phase').map((t) => (t as { n: string }).n);
---

<section class="method-scroll relative bg-bg text-ink lg:-mt-[14svh]" data-method-scroll aria-label="Le 6 fasi del progetto">
  <!-- telefono: titolo sopra la striscia, cosi la striscia parte subito con le fasi e le foto -->
  <div class="ms-intro-m lg:hidden">
    <p class="u-eyebrow mb-4">Metodo</p>
    <h2 class="font-sans font-extrabold uppercase leading-[0.88] tracking-[-0.02em] text-[clamp(2.6rem,11vw,4rem)]">{T.titolo.split(/\n/).map((riga, i) => <>{i > 0 && <br />}{riga}</>)}</h2>
    {nomeProgetto && <p class="mt-5 text-base text-muted leading-relaxed">{T.sottotitolo}<br /><a href={`/progetti/${metodoProgetto}/`} class="u-underline text-ink">{nomeProgetto}</a>.</p>}
    <div class="ms-intro-row">
      <p class="ms-lead ms-lead-m">{T.inizio}</p>
      <!-- invito a scorrere verso destra: la freccia porta avanti di una scheda -->
      <button type="button" class="ms-hint" data-hint aria-label="Scorri alle fasi successive">
        <span>Scorri</span>
        <span class="ms-hint-arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <div class="ms-pin lg:h-[100svh] flex items-start lg:overflow-x-auto lg:overflow-y-hidden [scrollbar-width:none]" data-pin>
    <!-- data-gallery: le immagini delle fasi si aprono a schermo intero con lo zoom (lightbox globale) -->
    <div class="ms-track relative flex items-start gap-[4vw] md:gap-[5vw] pl-[8vw] pr-[10vw] will-change-transform" data-track data-gallery>

      <div class="ms-mid shrink-0 pr-[3vw] max-w-[36rem] max-lg:hidden">
        <p class="u-eyebrow mb-4">Metodo</p>
        <h2 class="font-sans font-extrabold uppercase leading-[0.88] tracking-[-0.02em] text-[clamp(2.6rem,8vw,7rem)]">{T.titolo.split(/\n/).map((riga, i) => <>{i > 0 && <br />}{riga}</>)}</h2>
        {nomeProgetto && <p class="mt-6 text-base md:text-lg text-muted leading-relaxed whitespace-normal">{T.sottotitolo}<br /><a href={`/progetti/${metodoProgetto}/`} class="u-underline text-ink">{nomeProgetto}</a>.</p>}
        <!-- inizio della frase che prosegue con le fasi (su telefono, sotto) -->
        <p class="ms-lead ms-lead-start inline-flex items-center gap-4 whitespace-nowrap">{T.inizio} <span class="ms-go" aria-hidden="true">»</span></p>
      </div>

      {flow.map((it) => (
        it.kind === 'text' ? (
          <span class="ms-muted ms-conn shrink-0 lg:whitespace-nowrap">{it.t}</span>
        ) : (
          <div class="ms-phase shrink-0 flex flex-col items-start" data-phase={it.n}>
            <!-- su telefono la frase di collegamento sta dentro la scheda della fase -->
            <span class="ms-conn-m lg:hidden" aria-hidden="true">{T.passi[Number(it.n) - 1]?.frase}</span>
            <span class="ms-numwrap relative self-start">
              <span class="ms-num block font-display text-muted/45 leading-none">{it.n}</span>
              {it.media && it.media.kind === 'img' && (
                <figure class="ms-media">
                  <button
                    type="button"
                    class:list={['ms-shot group block w-fit overflow-hidden cursor-zoom-in', it.media.drawing ? 'bg-bg border border-line p-2 md:p-3' : 'bg-surface']}
                    data-lightbox
                    data-full={it.media.src.src}
                    data-alt={it.media.alt}
                    aria-label={`Ingrandisci: ${it.media.alt}`}
                  >
                    <Image src={it.media.src} alt={it.media.alt} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 88vw, 40vw" class:list={['ms-img transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]', it.media.drawing ? 'object-contain' : 'object-cover']} />
                  </button>
                  <figcaption class="mt-2 text-right text-[0.8rem] md:text-[0.86rem] uppercase tracking-[0.16em] text-muted">{it.media.cap}</figcaption>
                </figure>
              )}
            </span>
            <span class="ms-title font-sans font-extrabold uppercase tracking-tight mt-2 leading-none lg:whitespace-nowrap">{it.t}</span>
          </div>
        )
      ))}

      <div class="ms-mid shrink-0">
        <a href="/fasi-del-progetto/" class="inline-flex items-center gap-3 whitespace-nowrap font-sans font-extrabold uppercase tracking-tight text-[clamp(1.4rem,3vw,2.6rem)] group">
          {T.linkFinale}
          <span class="grid place-items-center w-14 h-14 md:w-16 md:h-16 rounded-full border border-ink group-hover:bg-ink group-hover:text-bg transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </a>
      </div>

    </div>
  </div>

  <!-- avanzamento: la linea cresce o cala con lo scorrimento, i 6 punti sono le fasi -->
  <div class="ms-progress absolute bottom-5 left-[8vw] right-[8vw] h-px bg-line">
    <span class="block h-full bg-ink w-0" data-progress></span>
    {fasiNum.map((n, i) => (
      <button type="button" class="ms-mark" data-mark={n} style={`left:${(i / (fasiNum.length - 1)) * 100}%`} aria-label={`Vai alla fase ${n}`}>
        <span class="ms-mark-n">{n}</span>
        <span class="ms-dot"></span>
      </button>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const setup = () => {
    const section = document.querySelector<HTMLElement>('[data-method-scroll]');
    const track = document.querySelector<HTMLElement>('[data-track]');
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const pinWrap = section?.querySelector<HTMLElement>('[data-pin]');
    if (!section || !track || !pinWrap) return;
    const marks = Array.from(section.querySelectorAll<HTMLElement>('[data-mark]'));
    const phases = marks.map((m) => track.querySelector<HTMLElement>(`[data-phase="${m.dataset.mark}"]`));

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // striscia nativa (telefono, tablet, movimento ridotto) o sequenza agganciata (desktop):
    // si decide in ogni momento, cosi cambiando la larghezza della finestra si passa dall'una all'altra
    const native = () => reduce || window.innerWidth < 1024;
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);

    // a che punto dello scorrimento ogni fase arriva a un terzo dello schermo
    let at: number[] = [];
    const measure = () => {
      const d = distance() || 1;
      at = phases.map((el) => (el ? Math.min(1, Math.max(0, (el.offsetLeft - window.innerWidth * 0.33) / d)) : 0));
      marks.forEach((m, i) => (m.style.left = `${(at[i] * 100).toFixed(2)}%`));
    };
    const paint = (p: number) => {
      if (bar) bar.style.width = (p * 100).toFixed(2) + '%';
      marks.forEach((m, i) => m.classList.toggle('is-on', p >= at[i] - 0.002));
    };
    measure();
    paint(0);
    window.addEventListener('resize', () => { measure(); });

    // ---------- striscia nativa: la linea segue lo scorrimento del contenitore ----------
    let nudging = false;
    pinWrap.addEventListener('scroll', () => {
      if (!native()) return;
      const max = pinWrap.scrollWidth - pinWrap.clientWidth || 1;
      paint(pinWrap.scrollLeft / max);
      // dopo il primo scorrimento dell'utente l'invito sparisce; in fondo togliamo la sfumatura a destra
      if (!nudging && pinWrap.scrollLeft > 40) section.classList.add('is-moved');
      section.classList.toggle('is-end', pinWrap.scrollLeft >= max - 4);
    }, { passive: true });

    // la freccia porta avanti di una scheda (in fondo torna all'inizio)
    section.querySelector('[data-hint]')?.addEventListener('click', () => {
      const max = pinWrap.scrollWidth - pinWrap.clientWidth;
      const step = (phases[0]?.offsetWidth ?? window.innerWidth * 0.78) + window.innerWidth * 0.07;
      const left = pinWrap.scrollLeft >= max - 4 ? 0 : pinWrap.scrollLeft + step;
      pinWrap.scrollTo({ left, behavior: reduce ? 'auto' : 'smooth' });
    });

    // le foto della striscia si caricano tutte dopo il caricamento della pagina: fuori schermo a destra
    // il caricamento differito del browser le lascerebbe bianche
    section.querySelectorAll<HTMLImageElement>('.ms-img').forEach((img) => (img.loading = 'eager'));

    // col mouse (finestra stretta sul computer) la striscia si trascina
    let dragX = 0, dragLeft = 0, dragging = false, moved = false, noClick = false;
    pinWrap.addEventListener('pointerdown', (e) => {
      if (!native() || e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true; moved = false; dragX = e.clientX; dragLeft = pinWrap.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragX;
      if (!moved && Math.abs(dx) > 5) { moved = true; pinWrap.classList.add('is-drag'); }
      if (moved) { e.preventDefault(); pinWrap.scrollLeft = dragLeft - dx; }
    });
    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        pinWrap.classList.remove('is-drag');
        // dopo un trascinamento il clic non apre l'immagine
        noClick = true;
        setTimeout(() => (noClick = false), 0);
      }
    });
    pinWrap.addEventListener('click', (ev) => { if (noClick) { ev.stopPropagation(); ev.preventDefault(); } }, { capture: true });
    pinWrap.addEventListener('dragstart', (e) => { if (native()) e.preventDefault(); });

    // la prima volta che la striscia entra nello schermo fa un piccolo "assaggio" verso destra e torna indietro
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!native() || !entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (pinWrap.scrollLeft > 0) return;
        nudging = true;
        pinWrap.style.scrollSnapType = 'none';
        pinWrap.scrollTo({ left: Math.min(90, window.innerWidth * 0.22), behavior: 'smooth' });
        setTimeout(() => {
          pinWrap.scrollTo({ left: 0, behavior: 'smooth' });
          setTimeout(() => { pinWrap.style.scrollSnapType = ''; nudging = false; }, 900);
        }, 650);
      }, { threshold: 0.45 });
      io.observe(pinWrap);
    }

    // ---------- desktop: sequenza agganciata, lo scroll verticale la fa avanzare ----------
    // gsap.matchMedia la crea sopra i 1024 px e la smonta da sola sotto (niente pagina bloccata se si stringe la finestra)
    let tween: gsap.core.Tween | null = null;
    gsap.matchMedia().add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      if (distance() <= 0) return;
      pinWrap.style.overflowX = 'hidden';
      pinWrap.scrollLeft = 0;
      tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => '+=' + distance(),
          pin: true,
          scrub: 0.6,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onRefresh: measure,
          onUpdate: (self) => paint(self.progress),
        },
      });
      return () => {
        tween = null;
        pinWrap.style.overflowX = '';
        measure();
        paint(0);
      };
    });

    // clic su una fase della linea: sul desktop porta lo scroll della pagina a quel punto, sulla striscia la fa scorrere
    marks.forEach((m, i) => m.addEventListener('click', () => {
      const st = tween?.scrollTrigger;
      if (st) window.scrollTo({ top: st.start + at[i] * (st.end - st.start), behavior: 'smooth' });
      else pinWrap.scrollTo({ left: at[i] * (pinWrap.scrollWidth - pinWrap.clientWidth), behavior: reduce ? 'auto' : 'smooth' });
    }));
  };

  if (document.readyState === 'complete') setup();
  else window.addEventListener('load', setup);
</script>

<style>
  .method-scroll {
    isolation: isolate;
    --num: min(clamp(3.5rem, 9vw, 8rem), 13svh);  /* numero della fase */
    --conn: clamp(1.3rem, 3.2vw, 3rem);          /* frasi di collegamento */
    --lead: clamp(2rem, 5.5vw, 5rem);            /* "Ogni edificio" */
    --title: clamp(1rem, 2.2vw, 1.9rem);         /* titolo della fase */
    --gap: clamp(1.25rem, 2.6svh, 2rem);         /* spazio tra scritta e foto */
    --mid: 44svh;                                /* altezza della riga delle scritte */
    --shot: clamp(187px, 27.5svh, 363px);        /* altezza foto e riquadri */
  }
  /* tutte le scritte stanno sulla stessa riga, a metà schermo; le immagini pendono sotto */
  .ms-track { margin-top: calc(var(--mid) - var(--num) / 2); }
  .ms-num { font-size: var(--num); }
  .ms-title { font-size: var(--title); }
  .ms-lead { font-family: var(--font-sans); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; font-size: var(--lead); line-height: 0.9; }
  /* "Ogni edificio »": come nella striscia del cliente, piu piccolo del titolo e all altezza delle immagini */
  .ms-lead-start { font-size: calc(var(--title) * 1.55); margin-top: clamp(3rem, 9svh, 6rem); }
  /* le » invitano a proseguire: si muovono piano verso destra */
  .ms-go { display: inline-block; font-weight: 400; animation: ms-go 1.8s ease-in-out infinite; }
  @keyframes ms-go { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(0.35em); } }
  .ms-muted { font-family: var(--font-display); font-style: italic; color: var(--color-muted); font-size: var(--conn); line-height: 1; }
  .ms-conn { margin-top: calc(var(--num) / 2 - var(--conn) / 2); }
  /* blocco d'apertura e link finale centrati sulla stessa riga */
  .ms-mid { margin-top: calc(var(--num) / 2); transform: translateY(-50%); }

  /* immagini: tutte alte uguali, sotto il titolo della fase e a SINISTRA del numero:
     il bordo destro coincide con la fine del numero e l'immagine si allunga sotto la frase di collegamento
     (impaginazione della striscia preparata dal cliente) */
  .ms-shot { height: var(--shot); }
  .ms-shot :global(.ms-img) { height: 100%; width: auto; max-width: none; }
  .ms-media { position: absolute; right: 0; top: calc(100% + 0.5rem + var(--title) + var(--gap)); display: flex; flex-direction: column; align-items: flex-end; }
  .ms-shot:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }

  .ms-conn-m { display: none; }

  /* telefono e tablet: striscia da scorrere col dito, una scheda per fase; la scheda dopo si vede
     a destra, cosi e chiaro che la sequenza continua (scorrere tutto in verticale allungava troppo la home) */
  @media (max-width: 1023px) {
    .ms-pin {
      height: auto; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      cursor: grab;
    }
    .ms-pin.is-drag { cursor: grabbing; scroll-snap-type: none; user-select: none; }
    .ms-intro-m { padding: clamp(3.5rem, 12vw, 5rem) 6vw 0; }
    .ms-intro-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
    .ms-lead-m { font-size: clamp(1.6rem, 7.5vw, 2.6rem); white-space: nowrap; }
    .ms-track { flex-direction: row; align-items: flex-start; gap: 7vw; margin-top: 0; padding: 1.75rem 6vw 1.25rem; transform: none !important; }
    .ms-track > * { scroll-snap-align: start; scroll-margin-left: 6vw; }
    .ms-mid { margin-top: 0; transform: none; padding-right: 0; align-self: center; }
    .ms-conn { display: none; }
    .ms-conn-m { display: block; order: 0; margin-bottom: 0.6rem; font-family: var(--font-display); font-style: italic; color: var(--color-muted); font-size: clamp(1.15rem, 5vw, 1.5rem); line-height: 1.1; }
    .ms-phase { width: 78vw; max-width: 30rem; display: flex; flex-direction: column; }
    /* frase, numero, titolo e poi l'immagine intera (nessun ritaglio) */
    .ms-numwrap { display: contents; }
    .ms-num { order: 1; }
    .ms-title { order: 2; white-space: normal; }
    .ms-media { position: static; order: 3; margin-top: 1rem; align-items: flex-end; width: fit-content; max-width: 100%; }
    /* le tavole quasi quadrate restano basse come le foto: schede di altezza simile */
    .ms-shot { height: auto; width: fit-content; max-width: 100%; }
    .ms-shot :global(.ms-img) { width: auto; height: auto; max-width: 100%; max-height: 58vw; }

    /* invito a scorrere in alto, linea con le 6 fasi sotto la striscia */
    .ms-hint {
      display: flex; align-items: center; gap: 0.75rem; background: none; border: 0; padding: 0; cursor: pointer;
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink);
      transition: opacity 0.4s ease;
    }
    .ms-hint-arrow {
      display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 9999px;
      background: var(--color-ink); color: var(--color-bg); font-size: 1.15rem; letter-spacing: 0;
      animation: ms-swipe 1.4s ease-in-out infinite;
    }
    @keyframes ms-swipe { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(0.6rem); } }
    .method-scroll.is-end .ms-hint { opacity: 0.3; }
    .ms-progress { position: relative; left: auto; right: auto; bottom: auto; margin: 2.6rem 6vw 3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-go, .ms-hint-arrow { animation: none; } }

  .ms-pin::-webkit-scrollbar { display: none; }

  /* indicatore delle 6 fasi sulla linea di avanzamento */
  .ms-mark {
    position: absolute; top: 0; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; cursor: pointer; background: none; border: 0; padding: 0;
  }
  .ms-dot { width: 9px; height: 9px; border-radius: 9999px; background: var(--color-bg); border: 1.5px solid color-mix(in srgb, var(--color-ink) 35%, transparent); transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease; }
  .ms-mark-n { position: absolute; bottom: 100%; margin-bottom: 0; font-size: 0.82rem; letter-spacing: 0.12em; color: var(--color-muted); transition: color 0.3s ease; }
  .ms-mark.is-on .ms-dot { background: var(--color-ink); border-color: var(--color-ink); transform: scale(1.15); }
  .ms-mark.is-on .ms-mark-n { color: var(--color-ink); }
  .ms-mark:hover .ms-dot { border-color: var(--color-ink); }
  .ms-mark:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; border-radius: 9999px; }
</style>
